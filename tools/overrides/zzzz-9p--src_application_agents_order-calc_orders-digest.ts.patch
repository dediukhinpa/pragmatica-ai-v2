+function staleBlock(
+  orders: readonly DigestOrder[],
+  labelOf: (order: DigestOrder) => string,
+  options: Required<OrdersDigestOptions>,
+): string[] {
+  const stale = orders.filter((order) => order.stale);
+  if (stale.length === 0) return [];
+  const shown = listedStale(orders);
+  const rest = stale.length - shown.length;
+  const first = shown[0];
+  const example = first === undefined ? 'заказ закрыт' : `заказ «${labelOf(first)}» закрыт`;
+  return [
+    `${STALE_BLOCK_TITLE_PREFIX} ${formatDaysGenitive(options.openMaxDays)}:`,
+    ...shown.map((order) => staleLine(order, labelOf(order), options.timezone)),
+    ...(rest > 0 ? [`• и ещё ${rest} ${pluralRu(rest, ['заказ', 'заказа', 'заказов'])}`] : []),
+    'Если по заказу ответ уже получен или он больше не нужен, напишите мне, например: ' +
+      `«${example}» - я закрою его, и он пропадёт из сводки.`,
+  ];
+}
