+/** Старые заявки, перечисленные по названию (остальные - «и ещё N»). */
+function listedStale(orders: readonly DigestOrder[]): DigestOrder[] {
+  return orders.filter((order) => order.stale).slice(0, ORDER_DIGEST_MAX_STALE_LISTED);
+}
+
+/** Все заявки, названные в сообщении: свежие плана дня и старые блока «Без ответа». */
+function listedOrders(orders: readonly DigestOrder[]): DigestOrder[] {
+  return [...listedFresh(orders), ...listedStale(orders)];
+}
+
+/**
+ * Строка старого заказа: название, дата отправки, число поставщиков и сколько дней без ответа.
+ * Подробного статуса по каждому поставщику здесь нет: заказ давно висит, нужно решение.
+ */
+function staleLine(order: DigestOrder, label: string, timezone: string): string {
+  const { progress } = order;
+  const suppliers = progress.suppliers.filter((supplier) => supplier.requestAt !== undefined);
+  const sent =
+    progress.firstSentAt === undefined
+      ? 'дата отправки не указана'
+      : `отправлено ${shortDate(localDateKey(new Date(progress.firstSentAt), timezone))}`;
+  return (
+    `• ${label}: ${sent}, поставщиков: ${suppliers.length}, ` +
+    `${formatDays(order.ageDays)} без ответа.`
+  );
+}
