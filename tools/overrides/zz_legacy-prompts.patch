+import { SEARCH_CONVERSATION_HISTORY_TOOL } from '@business-ai/core';
+
+/**
+ * Блоки промпта агентов Прагматики с предметными словами (КП, поставщики, заявки на закуп).
+ * Платформа даёт те же блоки в нейтральной редакции; здесь прежний текст проекта, чтобы
+ * инструкции модели не менялись при переезде на пакеты платформы.
+ */
+
+/** Когда обращаться к поиску по истории диалога. */
+export const HISTORY_SEARCH_PROMPT = `
+
+История диалога (${SEARCH_CONVERSATION_HISTORY_TOOL}): за деталями прошлых разговоров (номера
+сделок и КП, цифры, что обещали) ищи инструментом по истории, а не вспоминай по памяти. Цифры
+для действий перепроверь по базе, КП или сделке: источник важнее истории.`;
+
+/**
+ * Как пользоваться сводкой прошлых диалогов. Сводка приходит системной справкой в начале новой
+ * сессии; её цифры могли устареть, поэтому действие и документ строятся только на цифрах,
+ * проверенных инструментом.
+ */
+export const SESSION_SUMMARY_PROMPT = `
+
+Сводка прошлых диалогов.
+- Если в системной справке есть «сводка прошлых диалогов», это ваша память о предыдущих
+  разговорах с этим сотрудником: номера сделок, заявок и КП, поставщики, решения, что ждём. Не
+  пересказывайте её сотруднику без вопроса, а используйте, чтобы продолжить дело.
+- Цифры из сводки (цены, суммы, сроки, реквизиты) могли устареть. Перед тем как использовать их
+  в действии или документе, перепроверьте инструментом (база, КП, сделка). При расхождении
+  источник важнее сводки: берите цифру из него и скажите сотруднику, что она изменилась.`;
