+/** Знаки, которые ломают жирную разметку и теги в сообщении: из названий они убираются. */
+const MARKUP_CHARS = /[*[\]]/gu;
+
+/**
+ * Название поставщика для жирной строки `**Название:**`: знаки разметки (`*`, `[`, `]`) убраны,
+ * иначе название ломало бы выделение (этап 9p, решение владельца 22.11.2026). Пустое после
+ * очистки название - как «поставщик не определён».
+ */
+export function boldSupplierLabel(name: string): string {
+  const clean = name.replace(MARKUP_CHARS, '').replace(/\s+/gu, ' ').trim();
+  return clean === '' ? UNKNOWN_SUPPLIER_LABEL : clean;
+}
+
+/** Дата отчёта «дд.мм.гггг» из ключа даты `гггг-мм-дд` (день проверки в поясе бизнеса). */
+function reportDate(dateKey: string): string {
+  const [year = '', month = '', day = ''] = dateKey.split('-');
+  return `${day}.${month}.${year}`;
+}
