+/** Номер договора в строке заглушки: «№ 103/11-26» (первые строки документа). */
+const NUMBER_PATTERN = /№\s*(.+?)(?=\s+от\s|$)/u;
+/** Сколько первых строк просматривается при поиске номера, как в сервисе. */
+const NUMBER_SEARCH_LINES = 12;
+
+/** Правка номера в тексте заглушки: допись или замена; те же итоги, что у сервиса. */
+function editNumber(
+  lines: string[],
+  edit: NonNullable<AmendContractRequest['numberEdit']>,
+): {
+  status: 'appended' | 'replaced' | 'unchanged' | 'not_found';
+  before: string | null;
+  after: string | null;
+} {
+  const index = lines
+    .slice(0, NUMBER_SEARCH_LINES)
+    .findIndex((line) => NUMBER_PATTERN.test(line));
+  const line = lines[index] ?? '';
+  const before = NUMBER_PATTERN.exec(line)?.[1];
+  if (index < 0 || before === undefined || /^_+$/u.test(before)) {
+    return { status: 'not_found', before: null, after: null };
+  }
+  const separator = edit.separator ?? ' / ';
+  if (edit.mode === 'append' && before.endsWith(edit.text)) {
+    return { status: 'unchanged', before, after: before };
+  }
+  const after = edit.mode === 'append' ? `${before}${separator}${edit.text}` : edit.text;
+  lines[index] = line.replace(before, after);
+  return { status: edit.mode === 'append' ? 'appended' : 'replaced', before, after };
+}
