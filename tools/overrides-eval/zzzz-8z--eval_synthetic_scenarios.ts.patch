+/**
+ * Этап 8z: «ещё 10» после первого шорт-листа. Сценарии скриптуют правильное поведение: первая
+ * выдача как обычно (поиск, шорт-лист, вопрос менеджеру), на «ещё» - только showMoreSuppliers
+ * (шорт-лист заново не собирается). Страницу и вопрос выбора показывает код и заканчивает ход,
+ * на «новых нет» модель отвечает сама.
+ */
+function pagingFirstPage(id: string): StepOrBuilder[] {
+  return [
+    callTools(SEARCH_NAMES.map((name, i) => [`search-${i}`, name, { requestId: id }])),
+    callTool('c-build', 'buildShortlist', { requestId: id }),
+    (request) =>
+      callTool('c-ask', 'askManagerToChoose', {
+        requestId: id,
+        version: lastToolResult(request)['version'],
+      }),
+  ];
+}
+const showMore = (id: string, n: number): ScriptStep =>
+  callTool(`c-more-${n}`, 'showMoreSuppliers', { requestId: id, count: 10 });
+
+/** 10 из базы, затем «ещё»: остаток базы и интернет. */
+const orderMoreAfterTenBase: Script = sequence([
+  ...pagingFirstPage('req-30'),
+  showMore('req-30', 1),
+]);
