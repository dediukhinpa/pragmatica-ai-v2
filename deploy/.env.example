# Образец deploy/.env Прагматики v2. Копировать: cp .env.example .env && chmod 600 .env
# НЕ коммитить .env. Секреты (раздел 2) НЕ вписывать сюда руками: их создаёт gen-secrets.sh
# платформы в файл ${SECRETS_DIR}/secrets.env (вне репозитория и вне бэкапов). Запуск:
#   docker compose --env-file images.lock --env-file .env --env-file secrets.env \
#     -f deploy/compose.yml up -d
# (secrets.env последним, он перекрывает .env; образцы images.lock - images.lock.example).
# Все прежние имена переменных работают как раньше: compose.project.yml возвращает боевые
# значения там, где платформа задаёт другие умолчания. Названия скриптов в комментариях ниже
# унаследованы от прежнего репозитория; часть из них живёт в платформе (deploy/scripts/).
# Правило записи: строка «KEY=значение» без кавычек не содержит хвостового « # комментарий»
# (комментарий пишется строкой выше); проверяет scripts/env-example.test.sh.

# ---------- 1. Пути и образы ----------
# Каталог секретов (права 700, не входит в бэкапы). Ключ псевдонимизатора хранить отдельно от
# бэкапов.
SECRETS_DIR=/etc/pragmatika/secrets
# Данные ВМ: pgdata (БД) — на системном диске; веса эмбеддингов — отдельным каталогом (том, не
# образ).
DATA_DIR=/var/lib/pragmatika
MODELS_DIR=/var/lib/pragmatika/models
# Точка монтирования SMB-шары с документами (только чтение), см.
# systemd/srv-pragmatika-documents.mount
DOCUMENTS_HOST_DIR=/srv/pragmatika/documents
# Клиентский сертификат для шлюза: каталог с client.crt, client.key, ca.crt (права 600/700)
MTLS_DIR=/etc/pragmatika/mtls
# Словарь контактов для псевдонимизатора (строка = контакт, # = комментарий); файл должен
# существовать
PSEUDONYMIZER_CONTACTS_HOST_FILE=/etc/pragmatika/contacts.txt
# Предметная настройка сервисов платформы (словари, слова-исключения, правила шаблонов),
# каталог на сервере, в контейнеры идёт как /config только для чтения. Содержимое — на сервере
# и не в репозитории (образцы — config/*.example). Нет каталога = поведение без настройки.
#BAI_CONFIG_HOST_DIR=/etc/pragmatika/config
# Локальные шаблоны и правила доступа, лежащие только на сервере (монтируется в app только
# для чтения).
#LOCAL_HOST_DIR=/opt/pragmatika/local
# Миграции платформы (закреплённая копия deploy/platform/db) и проекта (db/app); умолчания
# заданы в compose.project.yml, менять нужно только при нестандартной раскладке на сервере.
#BAI_PLATFORM_DB_DIR=./db
#APP_MIGRATIONS_DIR=../../db/app
# Тег записей в журнале systemd (умолчание pragmatika) и метка проекта для сборщика логов.
#BAI_LOG_TAG=pragmatika
#COMPOSE_PROJECT_NAME=pragmatika
#ALLOY_COMPOSE_PROJECT=pragmatika
# Образы: в проде закрепить точной версией/дайджестом; pgvector не ниже 0.8 (миграция 019)
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg16
NGINX_IMAGE=nginx:1.27-alpine

# ---------- 2. Секреты (значения не писать в этот файл; генерирует gen-secrets.sh) ----------
# Строки ниже закомментированы намеренно: значения живут в ${SECRETS_DIR}/secrets.env, а
# активная пустая строка в .env перекрывала бы их при передаче окружения compose. Раскомментировать
# и вписывать значение в .env НЕ нужно.
# Пароль БД (генерируется)
#POSTGRES_PASSWORD=
# Ключ Fernet таблицы замен ПДн (генерируется). Потеряли = все замены нечитаемы.
# ХРАНИТЬ ОТДЕЛЬНО ОТ БЭКАПОВ: утечка бэкапа вместе с ключом раскрывает все ПДн.
#PSEUDONYMIZER_KEY=
# Bearer-секрет API псевдонимизатора: один и тот же у сервера и у ядра (генерируется).
#PSEUDONYMIZER_API_TOKEN=
# Виртуальный ключ агента со шлюза (выдаёт gateway/scripts/create-agent-keys.sh; вписать вручную)
#LITELLM_API_KEY=
# Bitrix24 (чат): входящий вебхук вида https://<портал>/rest/<userId>/<секрет>/ - секрет в пути,
# вписать вручную (в secrets.env, не сюда); см. раздел 6а и docs/RUNBOOK.md, «Bitrix24: чат»
#BITRIX24_WEBHOOK_URL=
# Токен ботов Bitrix24 (botToken, до 40 символов; общий для всех ботов; вписать вручную)
#BITRIX24_BOT_TOKEN=

# ---------- 3. БД ----------
POSTGRES_USER=pragmatika
POSTGRES_DB=pragmatika

# ---------- 4. Псевдонимизатор ----------
# true = дополнительно маскировать названия организаций; ИНН/ОГРН/счета маскируются всегда
PSEUDONYMIZER_MASK_LEGAL_ENTITY=false
# on = маскировать адреса уровня дома (улица+дом, индекс), город остаётся; off = откат этапа Г
PSEUDONYMIZER_ADDRESS_MASK=on
# Срок запроса ядра к псевдонимизатору, мс: включает очередь процессора (сервис один процесс).
# 300 с (было 10 с): десять одновременных ходов с прайсами дают до 60 запросов разом, десятый
# ход ждёт ~150 с (этап 239d); малый срок давал отказ и повтор уже брошенной работы
PSEUDONYMIZER_TIMEOUT_MS=300000
# Предел длины текста одного запроса к псевдонимизатору, символов (больше: 422). Худший текст
# такой длины обрабатывается 5,6 с в одиночку; поднимать только вместе с PSEUDONYMIZER_TIMEOUT_MS.
PSEUDONYMIZER_MAX_TEXT_CHARS=70000
# Предел числа разных токенов [TYPE_N] в тексте для /restore (больше: 422)
PSEUDONYMIZER_MAX_RESTORE_TOKENS=5000
# Предел числа текстов в одной пачке /pseudonymize_batch (больше: 413, ядро шлёт по 100)
PSEUDONYMIZER_MAX_BATCH_ITEMS=500
# Сколько запросов псевдонимизатор обрабатывает одновременно (этап 239f). Лишние сверх слотов
# сервис отвергает через 4 с (503), поэтому очередь держит ядро: PSEUDONYMIZER_MAX_INFLIGHT у
# core берётся из этого же значения, и 60 запросов (10 ходов x 6 проверок) ждут, а не падают.
# Слоты процессор не ускоряют (один процесс, GIL), память растёт линейно: ~130 МиБ на слот
# на обычных текстах, ~470 МиБ на худший текст. 0 у MAX_INFLIGHT (прямой запуск ядра) = без
# очереди. Поднимать только вместе с mem_limit pseudonymizer (check-host.sh предупреждает,
# если значение больше 2: со 64 слотами из старого .env сервис убивается по памяти за 42 с).
PSEUDONYMIZER_MAX_CONCURRENCY=2
# Предел ОДНОВРЕМЕННЫХ запросов ядра к сервису (не длина очереди: очередь ядра не ограничена,
# лишние ждут по порядку до срока хода). Пусто = равен PSEUDONYMIZER_MAX_CONCURRENCY (так слоты
# сервиса и предел не расходятся). Решение владельца (п. 20): 2 задано явно, как на бою.
PSEUDONYMIZER_MAX_INFLIGHT=2
# Срок хранения таблицы замен треда без обращений, дней: через столько дней после последней
# записи или восстановления тред удаляется целиком (сервис чистит сам). 0 = не удалять.
PSEUDONYMIZER_RETENTION_DAYS=90
# --- labops-pii v1.0.3: явные значения вместо умолчаний библиотеки ---
# Источник: stage-5/pii-owner-decisions.md (пп. 1-9, 18-20). Профилей библиотеки больше нет,
# LABOPS_PII_PROFILE задавать НЕЛЬЗЯ (сервис не стартует). Без явных значений библиотека
# ведёт себя иначе: хранилище в памяти и срок 24 ч (токены в тредах теряются).
# Хранилище токенов: sqlite на томе pseudonymizer-data (без этого токены не восстанавливаются).
PSEUDONYMIZER_STORE=sqlite
# Схема ключей тома: v2 (читается и прежним кодом). НЕ переключать на v3 без решения владельца.
PSEUDONYMIZER_KEY_SCHEME=v2
# Маршруты сервиса: склонение подписанта нужно ядру при подготовке документов; прочие выключены.
PSEUDONYMIZER_ENABLE_INFLECT_SIGNATORY=on
PSEUDONYMIZER_ENABLE_DELETE_THREADS=off
PSEUDONYMIZER_ENABLE_EXPOSE_BOOT_ID=off
PSEUDONYMIZER_ENABLE_CASE_LABELS=off
# Слова-исключения (основы названия проекта и торговой марки), через запятую. Реальные слова
# в репозиторий не кладутся: задаются на сервере здесь либо в /config/pii-allowed-words.txt
# (config/README.md). Пусто = название проекта маскируется как ФИО.
PII_ALLOWED_WORDS=
# Для шлюза (.env сервера шлюза, не этого файла; здесь только справка): режимы guard
# PII_GUARD_NAMES_MODE и PII_GUARD_ADDRESS_MODE (log_only либо enforce, не off) и флаги
# PII_GUARD_WINDOWED_SCAN=1, PII_GUARD_STRUCTURE_LIMIT=1, PII_GUARD_SCAN_PROCESSES=2,
# PII_GUARD_MALLOC_TUNING=1 с PII_GUARD_MEM_LIMIT=624m.

# ---------- 5. Документы и индексатор ----------
# Разрешённые шаблоны /render через запятую: точный путь файла или каталог (запись с «/» на
# конце = префикс каталога), например: dogovor.docx,Акты/. Читают и ядро (app), и сервис
# documents, оба одним значением. ОСНОВА ПУТЕЙ:
# каталог шаблонов TEMPLATES_SUBDIR (ядро передаёт сервису путь от него); если TEMPLATES_SUBDIR
# пуст - путь от корня шары. При TEMPLATES_SUBDIR=Шаблоны писать «dogovor.docx», а НЕ
# «Шаблоны/dogovor.docx» (иначе сборка любого договора получит отказ 403). Пусто = список не
# задан (путь шаблона необязателен, обход каталогов отклоняется). Когда задан, клиент обязан
# передавать templatePath.
DOCUMENT_TEMPLATE_ALLOWLIST=
# Шаблоны договоров и NDA (этап 78): пять файлов в каталоге TEMPLATES_SUBDIR (вариант А, ниже),
# например TEMPLATES_SUBDIR=Шаблоны/Договоры. Значение для DOCUMENT_TEMPLATE_ALLOWLIST (одна
# строка, без кавычек: пробелы в имени файла допустимы, запятая только разделитель;
# сверяется тестом services/documents/tests/test_template_allowlist.py и реестром в ядре).
# Раскомментируйте, если других шаблонов (КП, счёт) нет; иначе добавьте и их файлы или каталог
# «Папка/» - список ограничивает ВСЕ шаблоны.
#DOCUMENT_TEMPLATE_ALLOWLIST=2026_МГ_Шаблон_Договора_на_поставку_готовой_продукции.docx,2026_МГ_Шаблон_Договора_на_поставку_контрактной_продукции.docx,МГ Соглашение NDA.docx,Шаблон_ПР_Договора_на_поставку_готовой_продукции.docx,Шаблон_ПР_Договора_на_поставку_контрактной_продукции.docx
# Префикс каталога шаблонов у ядра: путь от TEMPLATES_SUBDIR, например «Договоры/». Шаблонами
# считаются только файлы с этим префиксом. Пусто = весь каталог TEMPLATES_SUBDIR.
TEMPLATES_PREFIX=
# Чистый шаблон заказчика для агента «Актуализация сайта»: путь к .xlsx ОТ корня
# шаблонов (TEMPLATES_SUBDIR), например «Сайт/шаблон.xlsx». Агент его только читает. Пусто или
# файла нет - агент просит сотрудника прислать шаблон в чат.
SITE_TEMPLATE_PATH=
# Папка реестров договоров («Юридическая документация») для агента «Подготовка документов»:
# files:<путь от корня файлов диска К> или templates:<путь от корня шаблонов>, например
# files:zakupki/Юридическая документация. Пусто = автопоиск папки в обоих корнях на глубину 3.
# Агент реестры только читает.
CONTRACT_REGISTRY_PATH=
# Виды документов, которые готовит агент «Подготовка документов» (через запятую из
# commercial_offer, invoice, contract, closing). Пусто = все виды (поведение прежнее).
# Для Прагматики: contract - только договоры и NDA; КП, счета и закрывающие выключены (код
# остаётся). Выключенный вид агент отклоняет сообщением, промпт и приветствие говорят только о
# договорах и NDA. Неизвестный вид - ошибка запуска.
DOCUMENTS_ENABLED_KINDS=contract
# Размер загружаемого файла, байт (100 МиБ, этап 231; было 50 МиБ). Загрузка лежит на томе
# documents-spool (диск), в памяти не растёт; выше 100 МиБ не поднимать без замера
DOCUMENTS_MAX_UPLOAD_BYTES=104857600
# Предел размера файла ТОЛЬКО для фонового /parse индексатора по пути, байт (1 ГиБ); не меньше
# предыдущего. Файл читается с шары по пути, в память и tmpfs не попадает (память зависит от
# вложений и ячеек, а не от этого числа). Загрузка телом (чат) режется предыдущим пределом
DOCUMENTS_BACKGROUND_MAX_UPLOAD_BYTES=1073741824
# Порог стабильности файла (файл моложе не читается: ещё копируется по SMB), секунд. Одно
# значение для сервиса documents и для ядра (в ядро уходит как STABLE_SECONDS).
DOCUMENTS_STABLE_SECONDS=180
# Бюджет времени одного /scan (хеширование), секунд; меньше клиентского таймаута индексатора
DOCUMENTS_SCAN_BUDGET_SECONDS=60
# Лимиты разбора xlsx/docx/pptx и бинарных xls/doc/rtf (защита от zip-бомб; превышение: 413).
# Умолчания рассчитаны на
# mem_limit 3670m сервиса documents: меняя их, пересчитайте память (services/documents/README.md).
# Сумма распакованных размеров всех частей архива, байт
DOCUMENTS_MAX_UNCOMPRESSED_BYTES=268435456
# Сумма распакованных размеров частей разметки (XML), байт; вложения-картинки сюда не входят
DOCUMENTS_MAX_XML_BYTES=50331648
# Бюджет узлов разметки docx (элемент и каждый его атрибут)
DOCUMENTS_MAX_XML_NODES=2000000
# Бюджет ячеек xlsx (ячейка, строка, площадь диапазонов; прочие элементы по 4 единицы)
DOCUMENTS_MAX_CELLS=1000000
# Максимальное отношение распакованного к сжатому для части разметки крупнее 1 МиБ
DOCUMENTS_MAX_COMPRESSION_RATIO=100
# Максимум частей в архиве
DOCUMENTS_MAX_ARCHIVE_ENTRIES=5000
# Сколько документов разбирается одновременно (память растёт кратно)
DOCUMENTS_PARSE_CONCURRENCY=1
# PDF разбирается в отдельном процессе; превышение любого предела: 413
# Максимальный размер PDF, байт
DOCUMENTS_MAX_PDF_BYTES=20971520
# Максимум страниц PDF
DOCUMENTS_MAX_PDF_PAGES=500
# Жёсткий потолок времени разбора PDF, секунд (процесс убивается)
DOCUMENTS_MAX_PDF_SECONDS=20
# Потолок виртуальной памяти процесса разбора PDF, байт (не больше слагаемых разбора xlsx/docx)
DOCUMENTS_MAX_PDF_MEMORY_BYTES=1073741824
# Конвертация договоров .doc и RTF в docx (LibreOffice): потолок времени, секунд, и виртуальной
# памяти процесса, байт (по замеру пик 450-780 МиБ; входит в правило mem_limit documents).
# 180 с: таблица спецификации в .doc растёт по времени быстрее квадрата числа строк (500 строк -
# 38 с, 1000 - 310 с), а память не растёт (этап 239d); дольше - отказ с просьбой сохранить в docx
DOCUMENTS_MAX_CONVERT_SECONDS=180
# Предел размера .doc/RTF на входе конвертации, байт (ранний 413; docx этим пределом не режется)
DOCUMENTS_MAX_CONVERT_INPUT_BYTES=20971520
DOCUMENTS_MAX_CONVERT_MEMORY_BYTES=1073741824
# Потолок анонимной памяти процесса LibreOffice, байт (RLIMIT_DATA, этап 239): гарантия для
# правила mem_limit documents; по замеру худшие .doc берут 159-254 МиБ, потолок 448 МиБ
DOCUMENTS_MAX_CONVERT_DATA_BYTES=469762048
# Сколько договорных заданий (/docx/*, конвертация .doc/RTF) идут одновременно в своём месте
# сверх слота разбора; менять вместе с mem_limit documents (services/documents/README.md)
DOCUMENTS_CONTRACT_CONCURRENCY=1
# Кэш результата конвертации .doc/RTF на томе спула (текст договоров, ПДн): срок жизни, с;
# записей; суммарный размер, байт. Читается не дольше TTL; с диска просроченное убирает
# фоновый сметальщик не позже чем через 60 с после TTL, новых договоров для этого не нужно.
# Запоминается только детерминированный отказ файла («не открылся»: битый, зашифрованный, чужой
# формат) и коротко, на время одной цепочки ручек (DOCUMENTS_CONVERT_FAIL_CACHE_TTL_SECONDS):
# три ручки /docx/* не конвертируют один такой файл трижды. Таймаут, нехватка памяти и места
# не запоминаются. TTL=0 выключает кэш (откат), FAIL_CACHE_TTL=0 - только запоминание отказов
DOCUMENTS_CONVERT_CACHE_TTL_SECONDS=600
DOCUMENTS_CONVERT_FAIL_CACHE_TTL_SECONDS=120
DOCUMENTS_CONVERT_CACHE_MAX_ENTRIES=16
DOCUMENTS_CONVERT_CACHE_MAX_BYTES=134217728
# Повышенные пределы ТОЛЬКО для фоновых запросов индексатора (заголовок X-Request-Priority:
# background); чат и прочие интерактивные запросы остаются на пределах выше. Память под них
# заложена в расчёт mem_limit (services/documents/README.md, «Лимиты фоновой индексации»).
# Размер PDF в фоне, байт (1 ГиБ; не больше DOCUMENTS_BACKGROUND_MAX_UPLOAD_BYTES). Память
# воркера PDF от размера файла не зависит (замер 50-700 МиБ: ~40 МиБ)
DOCUMENTS_BACKGROUND_MAX_PDF_BYTES=1073741824
# Потолок времени разбора PDF в фоне, секунд; держать меньше таймаута индексатора на /parse
# (240 с), иначе клиент оборвёт ожидание раньше. Замер: 500 страниц плотного текста 77 с
DOCUMENTS_BACKGROUND_MAX_PDF_SECONDS=180
# Сумма распакованных размеров частей xlsx/docx/pptx в фоне БЕЗ вложений, байт (80 МиБ);
# вложения (картинки, видео, .bin) не читаются и не считаются, предела вложений нет (этап 101);
# разметка дополнительно ограничена DOCUMENTS_MAX_XML_BYTES
DOCUMENTS_BACKGROUND_MAX_UNCOMPRESSED_BYTES=83886080
# Предел потока книги xls в памяти, байт (240 МиБ). Читается только поток книги без рисунков;
# при фрагментированном потоке xlrd копирует его ещё раз
DOCUMENTS_MAX_XLS_BYTES=251658240
# Максимум элементов в одном списке данных /render (больше: 413)
DOCUMENTS_MAX_RENDER_ROWS=5000
# Предел тела JSON (/export-table) и поля data в /render, байт (больше: 413)
DOCUMENTS_MAX_JSON_BODY_BYTES=8388608
# Картинки (этап 110). Наибольшая сторона после нормализации, px (больше модель зрения не берёт)
DOCUMENTS_IMAGE_MAX_SIDE_PX=1568
# Максимум входной картинки /images/normalize, байт (20 МиБ; больше: 413)
DOCUMENTS_IMAGE_MAX_INPUT_BYTES=20971520
# Максимум одной картинки после сжатия, байт (5 МиБ - предел блока картинки у провайдера)
DOCUMENTS_MAX_IMAGE_BYTES=5242880
# Максимум пикселей на входе (защита от decompression bomb; 40 Мп)
DOCUMENTS_MAX_IMAGE_PIXELS=40000000
# Картинок из одного документа при /parse extract_images, суммарно байт, минимальная сторона px
DOCUMENTS_MAX_IMAGES_PER_DOCUMENT=20
DOCUMENTS_MAX_IMAGES_TOTAL_BYTES=31457280
DOCUMENTS_MIN_IMAGE_SIDE_PX=80
# Сколько страниц pdf без текстового слоя рендерится в картинки
DOCUMENTS_PDF_RENDER_PAGES=20
# Детектор текста на картинке /images/detect-text (Tesseract в образе documents).
# Бинарь и языки; слово = не меньше MIN_WORD_CHARS букв/цифр с уверенностью не ниже MIN_CONF,
# «text» - не меньше MIN_WORDS таких слов
DOCUMENTS_OCR_BIN=tesseract
DOCUMENTS_OCR_LANGS=rus+eng
DOCUMENTS_OCR_MIN_WORDS=3
DOCUMENTS_OCR_MIN_CONF=40
DOCUMENTS_OCR_MIN_WORD_CHARS=2
# Одновременных процессов, мест в очереди, ожидание слота (мс; дальше 503), таймаут процесса (мс)
DOCUMENTS_OCR_CONCURRENCY=1
# Очередь 20 мест и ожидание 300 с (было 4 и 5 с): десять ходов по два прохода (проверка и
# распознавание), 15 с на проход; хвост ждёт 19 проходов = 285 с (этап 239g). Слот один - второй
# стоил бы +394 МиБ. Ждущий запрос держит файл на диске: 2 МиБ памяти на место
DOCUMENTS_OCR_QUEUE_MAX=20
DOCUMENTS_OCR_QUEUE_WAIT_MS=300000
DOCUMENTS_OCR_TIMEOUT_MS=15000
# Максимум пикселей для детектора (больше: not_recognized)
DOCUMENTS_OCR_MAX_PIXELS=20000000
# Подкаталог шары для индексации (пусто = вся шара)
INDEXER_SCAN_PATH=
# Корневая папка поставщиков на шаре: файлы <корень>/<имя поставщика>/... индексатор помечает
# поставщиком по имени папки (сопоставление с карточкой по нормализованному названию)
SUPPLIERS_ROOT_NAME=Поставщики
# Пауза между проходами индексатора, секунд
INDEXER_INTERVAL_SECONDS=300
# Порог стабильности файла для индексатора (пусто = значение сервиса documents)
INDEXER_STABLE_SECONDS=
# Защита от «шара отвалилась»: проход пропускается, если в корне меньше стольких записей
INDEXER_MIN_ENTRIES=1
# Предохранитель удалений: если за проход к удалению предложено больше этой доли известных
# документов (от 5 штук) или снимок шары неполный, удаления откладываются; 1 = выключено
INDEXER_DELETE_MAX_FRACTION=0.5
# Файлы шары крупнее этого (байт) не индексируются, пропуск пишется в состояние (1 ГиБ);
# не больше DOCUMENTS_BACKGROUND_MAX_UPLOAD_BYTES, иначе документы ответят 413
INDEXER_MAX_FILE_BYTES=1073741824
# Сколько раз пробовать неудачный файл (отсрочка растёт); дальше ждём изменения файла
INDEXER_MAX_ATTEMPTS=8
# Серверные пределы соединения индексатора с PostgreSQL, мс (0 = выключено): одна команда
# (замена документа, COPY с записью в HNSW) и ожидание чужой блокировки
INDEXER_PG_STATEMENT_TIMEOUT_MS=300000
INDEXER_PG_LOCK_TIMEOUT_MS=30000

# ---------- 6. Шлюз (зарубежный сервер, mTLS) ----------
# Шлюз (один, резервного нет): адрес и порт, имя из SAN серверного сертификата (gen-mtls.sh)
GATEWAY_HOST=
GATEWAY_PORT=443
GATEWAY_TLS_NAME=
MODEL_TIMEOUT_MS=120000
MODEL_MAX_TOKENS=4096
# Таймауты ядра к своим сервисам, мс. Разбор файла: при DOCUMENTS_PARSE_CONCURRENCY=1 второй
# большой прайс ждёт очереди; срок включает ожидание. 420 с (было 60 с, затем 300 с): при десяти
# одновременных ходах с тяжёлыми прайсами десятый ждёт ~220 с (этап 239d) и ещё один фоновый
# PDF индексатора, уже занявший слот, до 180 с (DOCUMENTS_BACKGROUND_MAX_PDF_SECONDS): 400 с
# (этап 239f). Тот же срок у /images/normalize, он стоит в той же очереди.
DOCUMENTS_PARSE_TIMEOUT_MS=420000
# Сборка документа (/render) и правка прайса: срок тоже с ожиданием слота (то же место, что у
# разбора), 420 с по той же причине
DOCUMENTS_RENDER_TIMEOUT_MS=420000
# Нормализация фото (/images/normalize) и распознавание текста с фото (/images/recognize-text,
# режим tokens, Tesseract в documents), мс. Оба срока включают ожидание очереди сервиса: десять
# фото разом - 20 проходов OCR по 12-13 с; прежние 30 с превращали ожидание в «фото не читается».
# Пусто = 420000 для нормализации (очередь разбора) и 360000 для распознавания (очередь OCR 300 с
# + проход Tesseract 15 с + запас; заменил MASK_TIMEOUT_MS для documents)
IMAGE_NORMALIZE_TIMEOUT_MS=
IMAGE_RECOGNIZE_TIMEOUT_MS=
# Договорные запросы (classify, party-block, amend .doc/.docx): срок ВКЛЮЧАЕТ ожидание единственного
# договорного места documents (DOCUMENTS_CONTRACT_CONCURRENCY), иначе 10-й договор подряд получает
# отказ по таймауту. 600 с покрывают десять тяжёлых .doc подряд и договор со спецификацией
# впереди в очереди (этап 239d)
DOCUMENTS_CONTRACT_TIMEOUT_MS=600000
# Запрос эмбеддингов (поиск по базе знаний)
EMBEDDINGS_TIMEOUT_MS=60000
# Предел шагов агента (вызовов модели и инструментов) на один ход
AGENT_MAX_STEPS=10
# Поиск агента по истории своего диалога: фрагментов в ответе и предел длины текстов, символов
HISTORY_SEARCH_MAX_RESULTS=5
HISTORY_SEARCH_MAX_CHARS=6000

# ---------- 6а. Ядро агентов (app) ----------
# Порт служебного HTTP ядра (/health, /ready): слушает только 127.0.0.1 внутри контейнера, наружу не
# публикуется
HEALTH_PORT=8088
# Агент, отвечающий сотрудникам в чате (id из реестра ядра: prices, documents, order-calc,
# site-export). По умолчанию documents: из такого чата передача задач недостижима, инструмент
# передачи есть только у order-calc (см. AGENT_HANDOFF_ORDER_CALC_TO_PRICES ниже).
CHAT_AGENT_ID=documents
# Несколько ботов в одном инстансе: JSON-объект «botId -> agentId», например
# {"prices":"prices","order":"order-calc"}. botId - строчные латинские буквы, цифры, «_», «-».
# Пусто (по умолчанию) = режим одного бота, ведёт CHAT_AGENT_ID (выше, по умолчанию documents).
# Чтобы включить несколько ботов, раскомментируйте CHAT_BOTS И закомментируйте (или очистите)
# CHAT_AGENT_ID выше: иначе documents останется агентом для событий без бота. Пустой
# CHAT_AGENT_ID при заданном CHAT_BOTS - такие события отклоняются.
# Все агенты таблицы должны быть в реестре ядра, иначе служба не стартует.
#CHAT_BOTS={"prices":"prices","documents":"documents","order":"order-calc","site":"site-export"}
# Канал Bitrix24 (этап 47). Заданы все три - BITRIX24_WEBHOOK_URL и BITRIX24_BOT_TOKEN (раздел 2)
# и BITRIX24_BOTS - чат работает через портал; не заданы - заглушка в памяти. Частично - ядро не
# стартует. BITRIX24_BOTS: JSON {"<botId>": {"id": <числовой id бота на портале>, "agent":
# "<agentId>"}}; botId - как в CHAT_BOTS. CHAT_BOTS можно не задавать: он берётся из agent-полей;
# если задан - обязан совпадать. Адрес вебхука: https (http допустим только для localhost).
#BITRIX24_BOTS={"prices":{"id":1,"agent":"prices"},"documents":{"id":2,"agent":"documents"},"order":{"id":3,"agent":"order-calc"},"site":{"id":4,"agent":"site-export"}}
# Автосоздание ботов при старте (по умолчанию false: боты созданы на портале вручную, id заданы
# выше). true: служба сама находит бота по коду (по умолчанию = botId) либо регистрирует его и
# сохраняет id в БД; "id" в BITRIX24_BOTS становится необязательным, а боту без "id" нужно
# "name". Необязательно: "description" (должность в профиле бота), "type" (bot по умолчанию;
# bot|network|openline|supervisor|personal), "code". Боты на портале НЕ удаляются и не
# переименовываются. Подробности и оговорка про ботов, созданных вручную, - docs/RUNBOOK.md.
BITRIX24_BOT_AUTOREGISTER=false
# Метка templateId в Chat.Message.send: детерминированный код отправки, по которому портал (если
# поддерживает) не создаёт второе сообщение при повторе. По умолчанию true. false - поле не
# уходит вовсе (выключатель, если портал отвергает метку). При отказе портала «неверный запрос»
# служба сама повторяет отправку без метки, а после 3 отказов подряд отключает её на 10 минут.
BITRIX24_SEND_TEMPLATE_ID=true
# Имя бота ("name") применяется при старте сервиса: смена имени здесь + перезапуск app
# переименует уже существующего бота на портале (меняется только имя).
# Образец для автосоздания (BITRIX24_BOT_AUTOREGISTER=true): отображаемые имена четырёх ботов
# (до 100 символов, скобки допустимы).
#BITRIX24_BOTS={"prices":{"agent":"prices","name":"Актуализация прайса"},"documents":{"agent":"documents","name":"Подготовка документов"},"order":{"agent":"order-calc","name":"Поиск поставщика"},"site":{"agent":"site-export","name":"Актуализация сайта"}}
# Интервал опроса портала, мс (1000..60000); лимит портала 2 запроса/с общий на всех ботов
BITRIX24_POLL_INTERVAL_MS=5000
# Предел размера файла сотрудника, байт (по умолчанию и максимум 100 МБ: большой файл идёт через
# диск, память ядра от его размера не растёт, этап 231)
BITRIX24_MAX_FILE_BYTES=104857600
# Предел занятого места тома временных файлов ядра (file-spool), байт; по умолчанию 2 ГиБ
FILE_SPOOL_MAX_BYTES=2147483648
# Каталог временных файлов ядра: в compose задан томом file-spool (/var/lib/pragmatika/spool),
# вне compose по умолчанию подкаталог временного каталога ОС
#FILE_SPOOL_DIR=/var/lib/pragmatika/spool
# Общий с сервисом документов том результатов правки файлов (этап 231): в compose задан
# (ядро /var/lib/pragmatika/exchange, documents /exchange). Убрать у ядра - результат снова
# приходит в JSON с base64 (откат).
#DOCUMENTS_RESULT_DIR=/var/lib/pragmatika/exchange
# Через сколько секунд брошенный файл результата удаляет сервис документов:
#DOCUMENTS_RESULT_TTL_SECONDS=3600
# Вложения задач, чатов и сделок Bitrix24 для расчёта заказа (читаются в память, на диск не
# пишутся). Права вебхука: task, disk, im, imbot, crm. Предел размера файла, байт (до 100 МБ):
B24_ATTACHMENT_MAX_BYTES=20971520
# Сколько вложений читать на одну заявку (1..50); остальные помечаются как не прочитанные
B24_ATTACHMENT_MAX_FILES=10
# Таймаут скачивания одного файла, мс (1000..300000)
B24_ATTACHMENT_TIMEOUT_MS=30000
# Суммарный объём текста вложений в контексте одной заявки, символов (1000..200000); остальное
# обрезается с пометкой
B24_ATTACHMENT_MAX_CHARS=20000
# Этап 48. Каталог сотрудников (отделы, рабочие группы), CRM (сделки, заметки) и чтение задач
# подключаются сами, когда настроен Bitrix24 (три переменные выше); отдельных флагов нет.
# Права вебхука: imbot, user, department, sonet_group (только при правилах по workgroups; в
# справочнике Bitrix24 для этих методов встречается и имя sonet), crm, task.
# Карта полей сделки (JSON, необязательна; пусто = товарные строки и срок = создание + 24 ч):
# {"items":{"source":"field","field":"UF_CRM_ITEMS","format":"lines"},
#  "deadlineField":"UF_CRM_DEADLINE","slaHours":24,"defaultUnit":"шт"}
BITRIX24_DEAL_FIELD_MAP=
# Инструменты приёма заявки у агента «Поиск поставщика» (текст, ссылка на задачу или сделку
# портала).
# По умолчанию выключено; без Bitrix24 принимается только текст.
ORDER_CALC_INTAKE_ENABLED=false
# Проверка полноты запроса до поиска поставщиков: агент сверяет запрос с эталонными формами
# (раздел 11 ТЗ) и спрашивает недостающее; поиск без проверки отклоняется. По умолчанию выключено.
ORDER_CALC_COMPLETENESS_ENABLED=false
# Ответ на утреннее напоминание «План на день» (этап 226): сводка запоминает показанные заявки,
# на «да, ответили» агент сам выбирает действие (закрыть, отложить, напомнить позже, уточнить), а
# сводка не показывает отложенные заявки до даты. Нужна MONITORING_ENABLED=true. По умолчанию
# выключено.
ORDER_REMINDER_REPLY_ENABLED=false
# Режим «дополнить присланный договор исполнителя» у агента «Подготовка документов»:
# сотрудник присылает договор поставщика (docx) и просит добавить наши реквизиты и/или наш
# номер; номер дописывается к номеру исполнителя, реквизиты вписываются в сторону заказчика,
# текст исполнителя не удаляется (код проверяет). Нужен вид документов contract и чтение файлов
# чата. По умолчанию выключено.
DOCUMENTS_COUNTERPARTY_AMEND_ENABLED=false
# Наши реквизиты (собственные юрлица проекта) из БД, а не из текста шаблонов (этап 230):
# агент договоров берёт реквизиты нашей стороны из таблицы own_legal_entities, нет записи юрлица -
# отказ; печатный блок шаблона сверяется с записью (расхождение - отказ); сотрудник с правом
# documents.update_own_requisites может изменить реквизиты через агента. Включать ТОЛЬКО после
# миграции 041 и заполнения таблицы (deploy/scripts/own-requisites-load.sh): иначе договоры
# отказывают. По умолчанию выключено. Фильтр «наших реквизитов» при обогащении карточек читает
# таблицу и без флага (вместе с OWN_COMPANY_REQUISITES).
OWN_REQUISITES_DB_ENABLED=false
# Ящики сотрудников, только ЧТЕНИЕ: агенты читают ответы поставщиков и прайс-почту. Письма
# поставщикам агент «Поиск поставщика» не отправляет: он выводит в чате готовый текст запроса, а
# письмо отправляет сам сотрудник (метку [RFQ-...] в теме не менять). По умолчанию выключено.
# Флаг без MAIL_* даёт «почта не подключена» (сводка запуска предупреждает «mailboxes: почта
# сотрудников не подключена»). Отправку этот флаг не включает.
EMPLOYEE_MAILBOX_ENABLED=false
# Отправка писем с ящика сотрудника черновиком с кнопкой «Отправить». Ни к одному агенту не
# подключена (агенты «Поиск поставщика» и «Актуализация прайса» писем не отправляют): флаг оставлен
# на будущее, держать false.
EMPLOYEE_MAIL_SEND_ENABLED=false
# Чей ящик читает плановый разбор прайс-почты, запущенный не сотрудником (id сотрудника в
# каталоге ящиков). Необязательно: пусто = плановый разбор отвечает «не указан ящик». Действует
# только при EMPLOYEE_MAILBOX_ENABLED=true.
PRICES_MAILBOX_OWNER_USER_ID=
# Приветствие (роль, примеры запросов, кнопки) при первом сообщении сотрудника в треде связки.
# По умолчанию выключено.
CHAT_GREETING_ENABLED=false
# Журнал хода чата: принятое сообщение записывается в БД до подтверждения источнику; после
# падения процесса ход один раз повторяется сам («Продолжаю после перезапуска»), второй сбой
# закрывает событие сообщением. Текст в записи - до закрытия, не дольше суток. Без миграций.
# По умолчанию выключено: очередь хода в памяти, при падении ответ теряется.
CHAT_TURN_JOURNAL_ENABLED=false
# Плановый мониторинг (этап 50): утренняя сводка по заказам в 9:00 по рабочим дням, еженедельная
# проверка прайс-файлов на диске (по понедельникам с 09:00; дата в названии старше 3 месяцев) и
# просмотр писем поставщиков с триггерами о ценах раз в 3 дня. Без модели: факты и тексты
# формирует код. По умолчанию выключено: тогда прежнее суточное напоминание по заказам,
# включение заменяет его сводкой. Недельных напоминаний о прайсах нет в любом режиме.
MONITORING_ENABLED=false
# Синхронизация цен с диска (диск - источник правды): раз в 10 минут новые и изменённые
# прайсы на сетевом диске ставятся агенту прайсов на импорт (не больше 5 файлов за тик).
# Первый запуск только запоминает текущее состояние диска. По умолчанию выключено.
PRICE_DISK_SYNC_ENABLED=false
# Первичный импорт существующих прайсов с диска (кроме «Архив...», «НЕ БРАТЬ» и прочего, что
# исключено PRICE_STALE_EXCLUDE_PATTERN): один раз, пачками по 5 файлов за тик, с черновиками
# карточек для неизвестных поставщиков и итоговой сводкой ответственному. Работает только при
# PRICE_DISK_SYNC_ENABLED=true. Сначала смета: deploy/scripts/price-import-estimate.sh.
# Включает только владелец. По умолчанию выключено.
PRICE_DISK_INITIAL_IMPORT_ENABLED=false
# Часовой пояс бизнеса (IANA): по нему считаются рабочий день и час проверок. Пусто = Europe/Moscow.
# Неверное значение - ошибка старта (само значение в сообщение не попадает).
BUSINESS_TIMEZONE=Europe/Moscow
# Утренняя сводка по заказам (9:00, рабочие дни): сколько дней с отправки запроса открытый заказ без
# КП показывается отдельной строкой; старше - одной строкой «и N заказов старше N дней». Пусто = 14.
ORDER_DIGEST_OPEN_MAX_DAYS=14
# Карточки поставщиков (этап 51): общая база компании, добавление поставщика текстом, файлом-
# шаблоном или пересланным письмом; запись только по кнопке сотрудника с правом
# suppliers.confirm_card (с этапа 234 - только руководители отделов Bitrix24, UF_HEAD); личные
# заметки связки «сотрудник + бот». По умолчанию выключено:
# без флага инструменты, промпты, кнопки и чат прежние.
SUPPLIER_CARDS_ENABLED=false
# Файл xlsx-шаблона для кнопки «Шаблон» (путь ВНУТРИ контейнера). Пусто = файл из образа
# (/app/templates/supplier-template.xlsx); нет файла - шаблон собирается кодом.
SUPPLIER_TEMPLATE_PATH=
# Выгрузка базы поставщиков файлом xlsx в чат (этап 215): агент «Поиск поставщика» собирает файл
# только с полями, которые назвал сотрудник (до 2000 строк и 2 МБ), значения в модель не идут.
# Право suppliers.export - только у руководителей отделов Bitrix24 (UF_HEAD, этап 234; справочник
# недоступен - запрет всем). Требует
# SUPPLIER_CARDS_ENABLED=true. По умолчанию выключено: инструмента нет.
SUPPLIER_EXPORT_ENABLED=false
# Необязательно: id сотрудников Bitrix24 через запятую, которых бот считает руководителями отделов
# независимо от UF_HEAD портала (запись карточек поставщиков, выгрузка базы). Для случая, когда
# оргструктуру портала менять нельзя. Право работает и при недоступном справочнике. Пусто = нет.
ACCESS_EXTRA_HEAD_USER_IDS=
# Предел времени на один ход в чате, мс: по истечении ход отменяется, сотруднику «временно
# недоступен». Больше MODEL_TIMEOUT_MS (запрос к модели), меньше таймаута задач очереди (15 мин)
CHAT_TURN_TIMEOUT_MS=600000
# Сколько за ход можно простоять в очередях сервисов (разбор и OCR в documents, псевдонимизатор),
# не тратя срок хода, мс. Ожидание очереди - решение владельца вместо отказа: фото при пике из
# десяти ходов идёт до 990 с, а ход - 600 с. Сверх кредита часы хода идут и во время ожидания.
# Расчёт по умолчанию: 420 + 360 + 360 + 420 = 1560 с, округлено до 30 минут
CHAT_TURN_WAIT_CREDIT_MS=1800000
# Размер пула соединений ядра с PostgreSQL, 1..32 (он же размер очереди запросов).
# Растить вместе с JOB_WORKER_CONCURRENCY, если чат и плановые запуски упираются в пул
DATABASE_POOL_SIZE=4
# Сколько плановых задач (в т.ч. возобновление после ответа человека) идут одновременно, 1..8.
# 1 = строго по одной, как раньше: ответ человека ждёт за долгим запуском агента (до 15 мин)
JOB_WORKER_CONCURRENCY=2
# Правила доступа «кто какого бота и какие действия»: JSON по образцу access-policy.example.json.
# Файл кладётся в ACCESS_POLICY_HOST_DIR на хосте; ACCESS_POLICY_FILE - путь ВНУТРИ контейнера.
# Пусто = политика «запрещено всем» (бот никому не отвечает). Битый файл = ядро не стартует.
ACCESS_POLICY_HOST_DIR=/etc/pragmatika/access
ACCESS_POLICY_FILE=
# Передача задач «Поиск поставщика» -> «Актуализация прайса» (асинхронно, через
# очередь заданий). По умолчанию
# выключена. Достижима только в инстансе, где чат ведёт order-calc (CHAT_AGENT_ID=order-calc):
# инициатор берётся из события чата. Сотруднику нужен доступ к ОБОИМ ботам (order-calc и prices,
# действие chat.message в ACCESS_POLICY_FILE), кнопкам вопроса - chat.button на боте чата:
# передача права не расширяет. Срок годности передачи 1 час. Миграций не требует.
AGENT_HANDOFF_ORDER_CALC_TO_PRICES=false
# Вопрос дочернего агента передачи уходит инициатору в чат, ответ (кнопка «Да»/«Нет», текст
# «#код ответ» либо простое сообщение инициатора при единственном открытом вопросе) возобновляет
# дочерний тред; без флага передача закрывается needs_human, как раньше. Текст сообщений
# проверяется на ответ только при включённом флаге (кнопки работают всегда); текст ответа
# стирается при использовании и закрытии передачи. Срок ответа 24 часа, не больше трёх вопросов на
# передачу. Действует только при AGENT_HANDOFF_ORDER_CALC_TO_PRICES=true (без неё молча
# игнорируется). Выкладка в два шага: откат на бинарь без поддержки состояния awaiting_human его
# не разберёт, поэтому сначала выкатить версию с флагом выключенным, затем включить. Откат
# версии кода - только когда открытых awaiting_human нет (RUNBOOK, раздел 11). Формату тредов
# откат не мешает. Миграций не требует.
HANDOFF_ASK_ENABLED=false
# Синхронный вызов агента как инструмента (родитель ждёт итога дочернего в том же ходе). По
# умолчанию выключен. Не зависит от флагов передачи. Включает только порты вызова (долговечные
# шаги, права, аудит) в зависимостях агентов; инструментов вызова в боевых декларациях пока нет,
# поэтому сам по себе поведения не меняет. Миграций не требует.
AGENT_CALL_ENABLED=false

# Почта сотрудников по IMAP + SMTP (этап 57, MDaemon). Включается ТОЛЬКО вместе с
# EMPLOYEE_MAILBOX_ENABLED=true и MAIL_MAILBOXES_FILE; все значения по умолчанию - «выключено».
# Файл ящиков (логины и пароли приложений, папки) по образцу deploy/mailboxes.example.json
# кладётся в MAIL_HOST_DIR на хосте с правами 0600/0640; MAIL_MAILBOXES_FILE - путь ВНУТРИ
# контейнера. Пароли в .env не пишутся. Подробно - docs/RUNBOOK.md, «Подключение почты MDaemon».
MAIL_HOST_DIR=/etc/pragmatika/mail
MAIL_MAILBOXES_FILE=
MAIL_IMAP_HOST=
# Порты ТОЛЬКО со STARTTLS: IMAP 143, SMTP 587 или 25. Порты с неявным TLS (IMAP 993, SMTP 465)
# НЕ поддерживаются и отклоняются при разборе настроек, до соединения: app НЕ стартует
# (весь сервис, включая чат), причина с подсказкой - в логе app (dc.sh logs app).
# Поправьте порт и пересоздайте app.
MAIL_IMAP_PORT=143
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=25
# true - разрешить работу БЕЗ шифрования, если сервер не объявляет STARTTLS: пароли и письма
# идут по сети открытым текстом. По умолчанию запрещено (отказ с понятной причиной).
MAIL_ALLOW_PLAINTEXT=false
# Путь в контейнере к PEM своего удостоверяющего центра (файл в каталоге MAIL_HOST_DIR, например
# /etc/pragmatika/mail/ca.pem), если STARTTLS сервера подписан не публичным центром. Проверка
# сертификата не отключается. Пусто = системные корни.
MAIL_TLS_CA_FILE=
# Сопоставление "имя:IP" для контейнера app, если имя в сертификате почтового сервера не
# резолвится в его адрес (MAIL_IMAP_HOST/MAIL_SMTP_HOST тогда = это имя). Пусто = не нужно.
MAIL_HOST_ALIAS=
# Идентификатор собственного сервера в заголовке Authentication-Results (authserv-id). Ответ
# сервера - только справка для обследования доверия, доверия он не даёт; пусто = справки нет.
MAIL_AUTHSERV_ID=
# Модель доверия к отправителям писем (этап 233). false = как раньше. true = ядро само проверяет
# подпись DKIM по сырому письму (ключ из DNS, нужен исходящий DNS) и считает доверенным отправителя
# с верной подписью домена From либо с адресом/доменом, уже записанным в карточке поставщика;
# ответ MDaemon (SPF там ошибается) доверия не даёт никогда. Реквизиты (ИНН/КПП, адрес,
# банковские) из писем не применяются автоматически ни при каком значении, цены из писем в базу
# не пишутся. Включать после замера (команда deploy/scripts/mail-trust-survey.sh).
MAIL_SENDER_TRUST_ENABLED=false
# Ослабление: доверять отправителю, домен которого совпадает с доменом сайта карточки. Только
# вместе с MAIL_SENDER_TRUST_ENABLED и только по результатам замера.
MAIL_SENDER_TRUST_WEBSITE_DOMAIN=false
# Ослабление: доверять письму-ответу на наше исходящее (In-Reply-To/References). По замеру.
MAIL_SENDER_TRUST_REPLY_THREAD=false
# Запасной разбор даты из названия прайса моделью (еженедельная проверка диска): только для имён,
# похожих на прайс, где код даты не нашёл. Модель - через обёртку псевдонимизации и алиас
# PRICES_MODEL (отдельного алиаса нет); ответ строго проверяется кодом (год/месяц/день в окне,
# не будущее, дата есть в названии), сбой/таймаут = «дата не найдена». Не более 30 вызовов за
# проверку. По умолчанию выключен (false): включать только по решению владельца.
PRICE_FILE_DATE_MODEL_FALLBACK=false
# Оценка письма поставщика моделью поверх кодового фильтра (уведомление «поставщик пишет об
# изменении цен»): not_relevant глушит уведомление, сбой/таймаут 30 с возвращают его. Модель - через
# обёртку псевдонимизации и алиас PRICES_MODEL (отдельного алиаса нет); тексты писем в журнал,
# очередь и аудит не попадают. По умолчанию true, но действует ТОЛЬКО при подключённой почте
# (EMPLOYEE_MAILBOX_ENABLED=true и настроенные ящики); без почты оценщик не создаётся.
# false - уведомляет один кодовый фильтр.
PRICE_MAIL_ASSESSOR_ENABLED=true
# Правка описаний выгрузочной таблицы сайта моделью (агент «Актуализация сайта», этап 225):
# столбец P сжимается до 1500 знаков (не обрезкой) и заодно правится орфография; код проверяет
# длину и что числа, артикулы, единицы и токены маски не изменены (одна повторная попытка, затем
# явная ошибка агенту). Модель - через обёртку псевдонимизации и алиас SITE_EXPORT_MODEL
# (отдельного алиаса нет). По умолчанию выключен (false): код отказывает в описании длиннее 1500
# знаков и просит агента сократить его своими словами, орфография не правится. Включать только
# по решению владельца.
SITE_TEXT_EDITOR_ENABLED=false
# Письма известных поставщиков с xlsx/xls/xlsm/csv/pdf во вложении идут на оценку и без
# слов-триггеров (при выключенном оценщике - сразу уведомление). Не больше стольких таких писем
# за прогон просмотра, остальные - на следующем тике.
PRICE_MAIL_SUPPLIER_ATTACHMENT_MAX_PER_RUN=50
# Разовый проход по общему ящику info@ (этап 220b): служба его НЕ запускает (периодического
# опроса нет), его запускает владелец вручную командой deploy/scripts/mail-info-backfill.sh.
# Проход читает ВСЕ письма ящика постранично, модель (через обёртку псевдонимизации, алиас
# PRICES_MODEL) решает, поставщик ли пишет; новые поставщики заводятся карточками (без признака
# черновика)
# (отправитель общего ящика не подтверждён), существующие карточки НЕ меняются: предложения
# собираются в файл отчёта, который применяется отдельным режимом после подтверждения. Нужны
# EMPLOYEE_MAILBOX_ENABLED=true, запись ящика с "kind": "source" в файле MAIL_MAILBOXES_FILE (без
# блока send) и непустые OWN_COMPANY_REQUISITES. Порядок: docs/RUNBOOK.md, «Разовый проход по
# общему ящику».
# Адрес ящика-источника (как в записи файла ящиков); аргумент --address команды важнее.
# Реальный адрес - только здесь, не в коде. Службу переменная не запускает и не проверяет.
INFO_MAILBOX_ENRICH_ADDRESS=
# Предел обращений к модели за один запуск команды (аргумент --max-model-calls важнее). При
# исчерпании запуск корректно останавливается с отчётом, повтор продолжает с необработанных писем.
INFO_MAILBOX_ENRICH_MAX_CLASSIFY_PER_RUN=500
# Окно прохода, дней (аргумент --days важнее): письма старше не разбираются. По умолчанию 730
# (два года).
INFO_MAILBOX_ENRICH_WINDOW_DAYS=730
# Проход по компаниям Bitrix24 CRM (этапы 221/243): компании с признаком «поставщик» (Клиенты ->
# Компании) создают и дополняют карточки базы. Расписания НЕТ: это разовая ручная команда
# `bash deploy/scripts/crm-suppliers-sync.sh [--dry-run] --report <файл> [--max-companies N]`
# (порядок: бэкап базы, --dry-run, запуск - docs/RUNBOOK.md, «Разовый проход по компаниям CRM»).
# Модель не участвует: значения пишет код через общий узел обогащения (сопоставление по ИНН,
# почте, домену, названию; заполненные поля не перезаписываются, расхождения только считаются).
# Компании с нашими реквизитами (OWN_COMPANY_REQUISITES) пропускаются. Команде нужны портал
# Bitrix24 (BITRIX24_WEBHOOK_URL, право crm) и непустые OWN_COMPANY_REQUISITES. Прежние
# переменные расписания (CRM_SUPPLIERS_SYNC_*, CRM_SUPPLIERS_FULL_RESYNC_EVERY_CYCLES) удалены:
# в старом .env они безвредны, их значения игнорируются.
# Что считать «поставщиком» в CRM: ОБЪЕДИНЕНИЕ признаков - компания с типом
# CRM_SUPPLIERS_COMPANY_TYPE (справочник COMPANY_TYPE, стандартный - SUPPLIER) ИЛИ из воронки
# компаний «Поставщики» (CRM_SUPPLIERS_CATEGORY_ID; читается через crm.item.list). Заданы оба -
# читаются оба множества
# (компания из обоих разбирается один раз); задан один - работает только он; не задан ни один -
# тип SUPPLIER. Значения (id воронки) задаются на сервере; тип по умолчанию SUPPLIER.
# Компании, у которых признак своего прохода не совпал, не читаются.
CRM_SUPPLIERS_COMPANY_TYPE=SUPPLIER
CRM_SUPPLIERS_CATEGORY_ID=
# Обзор почты сотрудников и предложения завести карточки (этап 222, пункт 10 списка заказчика):
# раз в 3 суток агент «Поиск поставщика» просматривает ящики сотрудников (EMPLOYEE_MAILBOX_ENABLED)
# и пишет каждому ОДНО сообщение: «в вашей почте есть письма от компаний, которых нет в базе,
# завести карточки?». Ответ «да», «нет» или «только 1 и 3» записывает инструмент агента;
# карточки заводит код по письмам (сразу боевые, без вопросов по форме). Поставщик
# (ИНН, домен или название) предлагается сотруднику один раз за всё время, отклонённый - никогда.
# Письма читаются предпросмотром, оценка - моделью через обёртку псевдонимизации (алиас
# PRICES_MODEL), письма с нашего домена и с нашими реквизитами (OWN_COMPANY_REQUISITES)
# пропускаются. По умолчанию ВЫКЛЮЧЕНО. Включение требует EMPLOYEE_MAILBOX_ENABLED=true и
# непустых OWN_COMPANY_REQUISITES, иначе ошибка старта. Как включить: docs/RUNBOOK.md,
# «Обзор почты сотрудников».
SUPPLIER_MAIL_PROPOSALS_ENABLED=false
# Автообогащение существующих карточек по письмам без вопросов человеку (решение владельца
# 10.11.2026). По умолчанию ВЫКЛЮЧЕНО; работает только вместе с SUPPLIER_MAIL_PROPOSALS_ENABLED.
# Пишутся только пустые нефинансовые поля (сайт, контакты, категории, бренды, регионы, условия
# поставки) от доверенного отправителя; реквизиты, банк и директор не применяются никогда.
# Включение и откат: docs/RUNBOOK.md, «Обзор почты сотрудников».
SUPPLIER_MAIL_PROPOSALS_AUTO_ENRICH_ENABLED=false
# Расписание: строго раз в 3 суток, не раньше 10:00 по BUSINESS_TIMEZONE (часовой пояс бизнеса,
# см. BUSINESS_TIMEZONE),
# письма за последние 7 суток, до 40 оценок моделью за СУТКИ на все ящики.
SUPPLIER_MAIL_PROPOSALS_INTERVAL_DAYS=3
SUPPLIER_MAIL_PROPOSALS_CHECK_HOUR=10
SUPPLIER_MAIL_PROPOSALS_WINDOW_DAYS=7
SUPPLIER_MAIL_PROPOSALS_MAX_CLASSIFY_PER_RUN=40
# Списка исключений нет (решение владельца 09.11): в обзор входят ВСЕ ящики, подключённые в
# общий доступ ящика агента (записи файла ящиков без kind=source). Общий адрес info@ (kind=source)
# в обзор не входит, он только для разового прохода по общему ящику.
# Рейтинг поставщика в шорт-листе вместе с моделью (ТЗ, разд. 4): модель оценивает 1..5 и пишет
# короткое обоснование по фактам карточки (без ФИО, контактов и реквизитов; тексты - через
# обёртку псевдонимизации и алиас ORDER_CALC_MODEL, отдельного алиаса нет). Код проверяет ответ,
# оценка кэшируется в таблице supplier_rating_cache по хэшу фактов (миграция 026), не более 10
# вызовов модели за сборку шорт-листа; сбой/таймаут 15 с/неверный ответ = прежнее правило по
# карточке (в кэш не пишется). По умолчанию true; false - только правило.
SUPPLIER_RATING_MODEL_ENABLED=true
# Шорт-лист менеджеру карточками-вложениями Битрикс24 (по карточке на поставщика, цены и сроки
# строками). Если портал отверг вложение, уходит обычный текст. По умолчанию true; false - только
# текст.
SHORTLIST_ATTACH_ENABLED=true
# Файл Excel «Шорт-лист_<номер заявки>.xlsx» с полной таблицей (все цены, тиражи, рейтинг) вслед за
# шортлистом. Выгрузка недоступна - файла нет, карточки уходят. По умолчанию true.
SHORTLIST_XLSX_ENABLED=true
# Веб-поиск поставщиков с моделью (ТЗ разд. 3-4): модель составляет 1-3 запроса по заявке и
# полям формы, со страниц лучших кандидатов достаёт город, контакты, цену и срок. Через обёртку
# псевдонимизации и ORDER_CALC_MODEL; код проверяет запросы и сведения. false - как раньше.
WEB_SEARCH_MODEL_ENABLED=true
# Классификация хитов веб-выдачи одним вызовом модели (через шлюз псевдонимизации, без
# контактов): отсев не того товара и тары, название компании. false - только отсев кодом.
WEB_HIT_CLASSIFY_ENABLED=true
# Этап 125: модель выбирает официальный сайт карточки базы из результатов поиска (адрес только из
# списка) и проверяет, что название - компания, а не категория товара. false - правило по словам.
SUPPLIER_SITE_MODEL_ENABLED=true
# Проверка строк прайсов моделью (этап 121): одним вызовом на сборку шорт-листа модель отвечает,
# какие найденные в базе строки - тот же товар, что в позиции заявки (отсев «Стеклянный медальон»
# и «Сокочай ... и Мёд» на «мёд»). Через шлюз псевдонимизации и ORDER_CALC_MODEL; в модель идут
# только позиции и названия товаров (без поставщиков и цен). false - строки принимаются как есть.
PRICE_RELEVANCE_ENABLED=true
# Сколько разных названий строк прайсов проверяется по одной позиции заявки.
PRICE_RELEVANCE_MAX_NAMES=40
# Порог косинусной близости векторной ветки гибридного поиска по прайсам (0..1); ниже - «не по
# теме». Ветки полнотекстового поиска и начала слова порогом не ограничены.
PRICE_SEARCH_MIN_COSINE=0.4
# Извлечение фактов со страниц сайтов поставщиков через отдельный маршрут шлюза
# /webpage/v1/messages (решение владельца 28.10: страницы сайтов - публичные данные, никакие ПДн
# со страницы - ФИО, телефоны, ИНН, реквизиты - не причина отказа ни в шлюзе, ни в ядре).
# Защиту даёт не шлюз, а очистка страниц в ядре (WEB_PAGE_PII_STRIP ниже). Включать ТОЛЬКО после
# WEBPAGE_ROUTE_ENABLED=1 на шлюзе и выкладки
# nginx-шаблонов, иначе запрос получит 404 (кандидат остаётся без сведений со страницы; при
# включённом флаге факты берутся разбором кодом). Если ORDER_CALC_MODEL не agent-main - добавьте
# его в WEBPAGE_ALLOWED_MODELS шлюза. По умолчанию false (прежний путь).
WEB_PAGE_MODEL_ROUTE=false
# Очистка текста страниц сайтов поставщиков от ПДн перед моделью (этап 188, 152-ФЗ): вырезаются
# ФИО, телефоны, почты и адреса (город остаётся), контакты компании берёт код из исходного
# текста. Значения: off - ничего; log_only - считать находки, писать в журнал и метрику
# web_page_pii_strip_total, модели текст как есть (по умолчанию); enforce - модели уходит
# очищенный текст, при сбое очистки страница модели не уходит. Действует при любом значении
# WEB_PAGE_MODEL_ROUTE. Откат: log_only или off и перезапуск ядра. Решение владельца
# (п. 15): на бою enforce; значение сверить на сервере перед выкладкой.
WEB_PAGE_PII_STRIP=enforce
# Обогащение веб-кандидатов страницей сайта: поиск «site:<домен> контакты» на каждого
# показанного кандидата (10 USD за 1000 поисков). Кандидатов и запросов на заявку - не больше
# значений ниже, параллелизм - сколько кандидатов обогащается одновременно.
WEB_ENRICH_MAX_CANDIDATES=10
WEB_ENRICH_MAX_QUERIES=10
WEB_ENRICH_CONCURRENCY=3
# Обогащение карточек поставщиков базы через интернет (этап 121): поиск Яндекса + реестры
# юрлиц (checko, rusprofile, list-org) + сайт поставщика. Нужен Яндекс-поиск. Для всех
# показанных поставщиков базы, до 2 платных поисков на каждого; найденное кэшируется 30 дней.
WEB_ENRICH_SUPPLIERS_ENABLED=false
# Сколько поставщиков за ход и за сутки обогащать (платные поиски Яндекса)
WEB_ENRICH_SUPPLIERS_MAX=5
WEB_ENRICH_SUPPLIERS_DAILY_MAX=100
# Закрытый Telegram-канал как источник поиска поставщиков для шорт-листа (этап 216). Ищет
# сервис чтения tg-reader на зарубежном шлюзе (РФ-сервер Telegram не видит), приоритет у
# кандидатов канала как у базы знаний, в шорт-листе они подписаны «из Telegram-канала». Текст
# постов до модели очищается от ПДн всегда. По умолчанию ВЫКЛЮЧЕНО. Включать только после
# того, как на шлюзе поднят сервис и сделан вход аккаунта (gateway/README.md, «Telegram-канал»).
TELEGRAM_CHANNEL_SOURCE_ENABLED=false
# Постов канала в разбор моделью за одну сборку шорт-листа (1..50): каждый пост - вызов модели.
# Не больше предела службы чтения на шлюзе (TELEGRAM_MAX_LIMIT, по умолчанию 50): больше она
# отклонит. Общий бюджет времени источника за сборку - 90 с (константа в коде); не уложился -
# в шорт-листе «источник недоступен», база не страдает.
TELEGRAM_SEARCH_MAX_POSTS=20
# Предел ожидания ответа сервиса чтения канала, мс.
TELEGRAM_SEARCH_TIMEOUT_MS=30000
# Адрес сервиса чтения; пусто - тот же шлюз по mTLS, что у моделей (LITELLM_BASE_URL).
TELEGRAM_READER_BASE_URL=
# Bearer-токен службы чтения. СЕКРЕТ: ПУСТОЙ намеренно, значение вписывает владелец (chmod 600,
# не коммитить). Тот же текст лежит на шлюзе в файле service_token каталога секретов tg-reader
# (/etc/pragmatika/telegram/service_token, режим 0600); создание - gateway/README.md. Обязателен
# при TELEGRAM_CHANNEL_SOURCE_ENABLED=true: без него ядро не стартует.
TELEGRAM_READER_TOKEN=
# Каналы, которыми ограничен поиск (через запятую; имя или числовой id); пусто - все каналы
# сервиса чтения.
TELEGRAM_CHANNELS=
# Поисков за ход агента (общий лимитер): 3 плана + 10 site: + запас. Обогащение карточек
# базы этот лимит не тратит.
WEB_SEARCH_MAX_PER_TURN=20
# Окно лимита поиска на сотрудника: не более N поисков за M минут (скользящее). Одна заявка
# тратит до ~14 поисков. N: 1..1000, M: 1..1440.
WEB_SEARCH_USER_MAX_PER_WINDOW=60
WEB_SEARCH_USER_WINDOW_MINUTES=10
MAIL_CONNECT_TIMEOUT_MS=10000
MAIL_COMMAND_TIMEOUT_MS=30000
MAIL_OPERATION_TIMEOUT_MS=120000
# Предел письма, байт: крупнее не скачивается и не отправляется. Писем за проход - не больше
# MAIL_MAX_PER_PASS, остаток читается в следующий раз.
MAIL_MAX_MESSAGE_BYTES=15000000
MAIL_MAX_PER_PASS=50

# ---------- 7. Бэкапы (scripts/backup.sh) ----------
# Публичный ключ age для шифрования бэкапов (создаёт gen-secrets.sh; закрытая часть — офлайн)
BACKUP_AGE_RECIPIENT=
# S3-совместимое хранилище в РФ. Ключи доступа — секрет: вписать в secrets.env
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ru-central1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=pragmatika
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Сколько дней хранить копии в S3 и локально
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_DIR=/var/backups/pragmatika
BACKUP_LOCAL_RETENTION_DAYS=3
# Каталог sha256 архивов (эталон целостности вне S3, R3-SEC-7); копировать в офлайн-хранилище.
BACKUP_CHECKSUM_DIR=/var/backups/pragmatika/checksums
# Подпись эталона sha256 архива (R4-RES-6): закрытый ключ на ВМ (его создаёт gen-secrets.sh),
# открытый - в офлайн-хранилище владельца и здесь (на новой ВМ без него `restore latest` не
# проверит эталон из S3 и потребует --allow-unverified-archive).
BACKUP_SIGN_KEY_FILE=/etc/pragmatika/secrets/backup-sign.key
BACKUP_SIGN_PUBLIC_KEY=
# Нижняя граница свободного места перед бэкапом, ГиБ (нужное считается от размера БД и intake)
BACKUP_MIN_FREE_GB=5
# 1 = отказ, если каталог бэкапа на одной ФС с данными Postgres (иначе только предупреждение)
BACKUP_REQUIRE_SEPARATE_FS=0
# Именованный том с файлами сотрудников из чата (входит в бэкап и восстановление, R4-RES-11)
INTAKE_VOLUME=pragmatika_intake-data
# 1 = не включать knowledge_chunks (производная, восстанавливается переиндексацией): бэкап в разы
# меньше
BACKUP_EXCLUDE_KNOWLEDGE=0

# ---------- 8. Обслуживание ----------
# Сколько дней хранить завершённые разовые задачи jobs (как FINISHED_JOB_RETENTION_DAYS в ядре)
PURGE_RETENTION_DAYS=30
# Журнал аудита: через сколько дней очищается содержимое details (остаётся кто/что/когда) и через
# сколько строка удаляется целиком. Метрики операций - срок хранения. feedback не чистится.
AUDIT_DETAILS_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
METRICS_RETENTION_DAYS=400

# --- ядро (app) ---
# Подпапка шары с прайсами, например prices/ (пусто = корень шары)
PRICES_SUBDIR=
# Подпапка шары с шаблонами документов. Вариант А для договоров и NDA: каталог на шаре,
# например TEMPLATES_SUBDIR=Шаблоны/Договоры, пять файлов лежат прямо в нём (список в разделе 5,
# строка #DOCUMENT_TEMPLATE_ALLOWLIST=). Шара только для чтения. Вариант Б (отдельный каталог
# на сервере) описан в deploy/README.md, «Шаблоны договоров и NDA».
TEMPLATES_SUBDIR=
# Вариант Б: отдельный каталог шаблонов на РФ-сервере, монтируется в app только на
# чтение. Не задан - используется тот же каталог, что DOCUMENTS_HOST_DIR (вариант А). При
# варианте Б TEMPLATES_SUBDIR оставьте пустым: пять файлов лежат прямо в этом каталоге.
#TEMPLATES_HOST_DIR=/srv/pragmatika/templates
# Id чата менеджера для отчётов (из мессенджера)
MANAGER_THREAD_ID=
# Платформа называет ту же настройку OWNER_THREAD_ID. Если не задана, берётся значение
# MANAGER_THREAD_ID (compat.env), так что прежний .env работает без правок.
#OWNER_THREAD_ID=
# Необязательно: ответственный за подтверждения скачков цен (тред <бот>/<id сотрудника>).
PRICE_RESPONSIBLE_THREAD_ID=
# Необязательно: отделы (department:<id> или id отдела Bitrix24), несколько - через запятую,
# например 22,88. Задан - недельная сводка по устаревшим прайсам идёт тем, кто создал файл или
# последним его сохранял (имена из свойств файла сопоставляет код, без модели); папка с фамилией
# сотрудника этих отделов (с подотделами) сопоставляется по пути; остальные файлы - в
# PRICE_RESPONSIBLE_THREAD_ID. Родительский отдел (корень компании) притянет всех: сотрудников
# из корня добавляйте через PRICE_STAFF_EXTRA_USER_IDS.
PRICE_STAFF_DEPARTMENT=
# Необязательно: id сотрудников Bitrix24 через запятую, добавляемые к составу для сопоставления
# по фамилии в пути отдельно от отделов (сотрудник из корня компании или отдела вне закупок).
# Только они, без PRICE_STAFF_DEPARTMENT, тоже включают адресную раздачу.
PRICE_STAFF_EXTRA_USER_IDS=
# Необязательно: бот сам пишет первым сотруднику, который ещё не открывал диалог с ботом
# «Актуализация прайса» (адресат недельной сводки и вопроса «чей прайс»; тред <бот>/<id>). Нужен
# CHAT_BOTS с однозначным ботом прайсов. Сотрудникам, которым политика доступа запрещает бота,
# ничего не уходит. false = адресат только из реестра обращений (прежнее поведение).
PRICE_RECIPIENT_OPEN_THREAD=false
# Необязательно: id сотрудников Bitrix24 через запятую, которые не получают недельную сводку по
# прайсам ни на одном шаге (системный администратор, тестовая учётка), например 28,690.
PRICE_RECIPIENT_EXCLUDE_IDS=
# Необязательно: область недельной проверки устаревших прайсов (не влияет на инструменты агента и
# на PRICES_SUBDIR). Префиксы путей от корня диска через запятую, например produkciya/;
# пусто = весь корень.
PRICE_STALE_SCAN_PREFIXES=
# Необязательно: регулярное выражение по сегментам пути (без учёта регистра): подходящие файлы
# в проверку не входят. Невалидное - ошибка запуска. Пусто: `архив|не брать` действует, только
# если заданы префиксы или включён PRICE_STALE_CONTENT_CHECK (иначе поведение прежнее).
PRICE_STALE_EXCLUDE_PATTERN=
# Прайс = слово «прайс»/«price» в имени ИЛИ таблица цен в разобранном тексте файла (база знаний).
# false = прежнее правило (всё, что не опознано как «не прайс»).
PRICE_STALE_CONTENT_CHECK=false
# Наши юрлица через «;»
OWN_COMPANY_NAMES=
# Реквизиты наших юрлиц через «;» (ИНН, КПП, ОГРН, адрес, почта, телефон; можно со словом:
# «ИНН 7701234567»). Код не даёт записать их в карточку поставщика, когда агенты «Подготовка
# документов» и «Актуализация сайта» дополняют карточку из документа (там есть и наши
# реквизиты). Сравнение по цифрам (ИНН/КПП/ОГРН), последним 10 цифрам (телефон) и вхождению
# строк (адрес, почта, название). ПУСТО = безопасный режим: ИНН, КПП, ОГРН, адреса, ФИО
# директора и контакты из документов в карточки не пишутся вообще; для работы дополнения задайте.
OWN_COMPANY_REQUISITES=
# Алиас модели агента «Актуализация прайса» из конфига шлюза
PRICES_MODEL=
# Алиас модели агента «Подготовка документов» из конфига шлюза
DOCUMENTS_MODEL=
# Алиас модели агента «Поиск поставщика» из конфига шлюза
ORDER_CALC_MODEL=
# Алиас модели агента «Актуализация сайта» из конфига шлюза
SITE_EXPORT_MODEL=

# --- телеметрия ядра (этап 91) ---
# Трассы и метрики ядра по OTLP/HTTP. По умолчанию ВЫКЛЮЧЕНА: без флага работает заглушка
# (нет таймеров, сетевых запросов и заголовка traceparent), прежние поля журнала
# сохранены, добавлены ts, level, severity (и trace_id/span_id/agent/bot/thread_h/turn при
# включённой телеметрии). Наружу уходят только коды, числа и короткие хэши: тексты сообщений, ФИО,
# телефоны и e-mail не
# попадают. Не путать с MONITORING_ENABLED (бизнес-сводки). Приёмник (Alloy) и стек
# мониторинга - этап 93: пока их нет, флаг не включать.
#TELEMETRY_ENABLED=false
# Адрес приёмника OTLP/HTTP (http:// или https://); пути /v1/traces и /v1/metrics добавляются.
# Обязателен при TELEMETRY_ENABLED=true, иначе ошибка старта.
#TELEMETRY_OTLP_ENDPOINT=http://alloy:4318
# Токен компании для приёмника (заголовок Authorization: Bearer). Секрет: значение вписывать
# в ${SECRETS_DIR}/secrets.env, а не сюда; не коммитить и не выводить в журнал. Пусто = без
# заголовка.
#TELEMETRY_OTLP_TOKEN=
# Секрет HMAC-SHA256 для thread_h (хэш идентификатора треда в журнале и спанах). Обязателен
# при TELEMETRY_ENABLED=true (не короче 16 символов), иначе ошибка старта. Секрет: значение
# создаёт gen-secrets.sh в ${SECRETS_DIR}/secrets.env, сюда не вписывать; смена ключа рвёт
# сопоставление старых и новых хэшей. При TELEMETRY_ENABLED=false не нужен.
#TELEMETRY_HASH_KEY=
# Имя сервиса в телеметрии. Пусто = pragmatika-core.
#TELEMETRY_SERVICE_NAME=pragmatika-core
# Как часто отправлять накопленное, мс. Пусто = 5000.
#TELEMETRY_FLUSH_INTERVAL_MS=5000
# Таблица цен моделей по алиасу (JSON; путь ВНУТРИ контейнера; файл нужно смонтировать в
# контейнер app самим). Цены, а не конфиг моделей. Пусто = встроенные значения по умолчанию.
#MODEL_PRICES_FILE=
# Предупреждение agent_turn_cost_high: стоимость одного хода агента выше, USD (число > 0).
# Пусто = не проверяется.
#AGENT_TURN_COST_WARN_USD=
# Предупреждение model_call_cost_high: стоимость одного вызова модели выше, USD (число > 0).
# Пусто = не проверяется.
#MODEL_CALL_COST_WARN_USD=
# Жёсткий стоп хода по стоимости: новый шаг модели не начинается, если известная стоимость хода
# выше предела. По умолчанию выключен (поведение прежнее). true без предела - ошибка старта.
#AGENT_TURN_COST_HARD_STOP=false
# Предел стоимости хода для жёсткого стопа, USD (число > 0); действует только при HARD_STOP=true.
#AGENT_TURN_COST_HARD_LIMIT_USD=
# Бюджет токенов контекста агента. Окно модели за алиасом agent-main, токенов (целое > 0);
# пусто = 350000 (окно claude-sonnet-5-5 - 1 млн; 350 тыс. - решение владельца). Меняйте вместе с
# MAIN_MODEL в gateway/.env.
#CONTEXT_WINDOW_TOKENS=
# Резерв окна на шаги хода с инструментами (результаты инструментов копятся от шага к шагу),
# токенов; пусто = 80000. Он же задаёт предел суммарного размера результатов читающих
# инструментов за ход (в символах - вдвое больше).
#CONTEXT_STEPS_RESERVE_TOKENS=
# Доля окна под системные блоки (личные заметки, сводка прошлых сессий), %; пусто = 10.
#CONTEXT_SYSTEM_SHARE_PERCENT=
# Порог предупреждения context_window_high: самый большой запрос хода занял больше этой доли
# окна, %; пусто = 70. Резерв на ответ берётся из MODEL_MAX_TOKENS.
#CONTEXT_WARN_PERCENT=
# Сессии диалога. Часов тишины от последней активности до новой сессии (число > 0); пусто = 8.
# Новая сессия не видит истории прежней, но получает её сводку (память о делах, номерах,
# решениях). История остаётся в базе.
SESSION_IDLE_HOURS=8
# Предел размера накопленной сводки сессий, символов; пусто = 8000. Должен помещаться в долю
# окна под системные блоки (CONTEXT_SYSTEM_SHARE_PERCENT), иначе служба не стартует.
#SESSION_SUMMARY_MAX_CHARS=
# Сколько мс первая реплика новой сессии ждёт свежую сводку (0 = не ждать); не дождались -
# ход идёт с прежней сводкой, сводка дописывается после хода. Пусто = 20000.
#SESSION_SUMMARY_WAIT_MS=
# Кнопка «Новый диалог» под ответом бота, когда сессия стала длинной (самый большой запрос хода
# занял больше CONTEXT_WARN_PERCENT окна): не чаще раза за столько ходов (целое > 0). В
# приветствии кнопки нет; при переполнении окна она есть всегда. Пусто = 5.
NEW_DIALOG_HINT_EVERY_TURNS=5
# Алерты в Telegram (отдельный бот): используется стеком мониторинга (этап 93), не ядром;
# ядро этих переменных не читает. Только пустые плейсхолдеры: значения владелец кладёт на
# сервер мониторинга при выкатке, в git и в этот образец реальные значения не попадают.
#ALERT_TELEGRAM_BOT_TOKEN=
#ALERT_TELEGRAM_CHAT_ID=

# --- песочница скриптов агентов (этап 111, профиль compose agent-sandbox) ---
# Включение: COMPOSE_PROFILES=agent-sandbox (можно вместе с telemetry через запятую) и
# AGENT_SANDBOX_ENABLED=1. По умолчанию выключено: без профиля сервиса нет, с профилем, но без
# флага, процесс выходит с кодом 3. Ядро читает тот же флаг: включён - у агентов появляется
# инструмент runDataScript (сокет /run/sandbox/sandbox.sock задан в compose, SANDBOX_SOCKET).
# Сервису нужны +768 МиБ ОЗУ (mem_limit 768m, этап 244; check-host.sh учитывает профиль), раздел
# RUNBOOK «Песочница».
#AGENT_SANDBOX_ENABLED=0
# Допуск по памяти (этап 244): новый запуск скрипта ждёт в очереди (до SANDBOX_QUEUE_WAIT_SECONDS,
# затем прежний queue_timeout), пока memory.current контейнера + оценка запуска не уложатся в
# memory.max минус запас и MemAvailable хоста не станет не ниже порога. Пустая песочница допускает
# запуск всегда; нет данных cgroup/meminfo - один запуск одновременно. Умолчания ниже.
#SANDBOX_MEMORY_GATE=1
#SANDBOX_MEMORY_RUN_ESTIMATE_MIB=512
#SANDBOX_MEMORY_RESERVE_MIB=64
#SANDBOX_MEMORY_HOST_MIN_AVAILABLE_MIB=1536
#SANDBOX_MEMORY_RAMP_SECONDS=3
# Шаг, после которого работа с файлом получает подсказку «перейди к разбору скриптом» (один раз
# за ход, только при включённой песочнице). По умолчанию 15; предел шагов хода AGENT_MAX_STEPS
# не меняется, серия попыток скрипта поднимает его на 6 шагов один раз за ход.
#AGENT_SCRIPT_FALLBACK_STEP=15

# --- сборщик телеметрии Alloy (этап 93, профиль compose telemetry) ---
# Включение: COMPOSE_PROFILES=telemetry (рядом TELEMETRY_ENABLED=true и
# TELEMETRY_OTLP_ENDPOINT=http://alloy:4318 для ядра). Без профиля сервиса alloy нет.
# Перед первым запуском: каталог textfile-метрик `install -d -m 0755 ${TEXTFILE_METRICS_DIR}`,
# роль Postgres только для чтения (deploy/README.md), приёмник на нашей стороне.
#COMPOSE_PROFILES=telemetry
# Образ сборщика; версия закреплена в compose, менять только осознанно.
#ALLOY_IMAGE=grafana/alloy:v1.11.3
# Прокси Docker API только на чтение для сборщика (docker.sock монтируется только в него).
#DOCKER_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0
# Куда слать: local (стек рядом с компанией), remote (наш приёмник), both (оба).
#TELEMETRY_TARGETS=remote
# Метка company на всех метриках, логах и трассах (латиница, цифры, дефис); он же сегмент
# пути приёма /ingest/<COMPANY_ID>/... на общем хосте мониторинга.
#COMPANY_ID=
# Метка host (имя хоста контейнера сборщика). Пусто = pragmatika.
#TELEMETRY_HOST=
# Базовые адреса приёмников. REMOTE: https://<хост-мониторинга> (общий хост, без /ingest и
# без завершающего "/"; пути /ingest/<COMPANY_ID>/prometheus/api/v1/write,
# /ingest/<COMPANY_ID>/loki/api/v1/push, /ingest/<COMPANY_ID>/otlp добавляет сборщик); LOCAL:
# фронт стека без токена, см. alloy/README.md.
#TELEMETRY_LOCAL_URL=
#TELEMETRY_REMOTE_URL=
# Токен компании для нашего приёмника (Bearer). Секрет: значение вписывать в
# ${SECRETS_DIR}/secrets.env, а не сюда; не коммитить и не выводить в журнал.
#TELEMETRY_COMPANY_TOKEN=
# DSN пользователя Postgres ТОЛЬКО ЧТЕНИЕ (роль pg_monitor). Содержит пароль: секрет, в
# secrets.env; пароль в URL кодируется. Пусто = pragmatika_monitor без пароля (проба упадёт).
#TELEMETRY_PG_DSN=
# Каталог textfile-метрик скриптов deploy/ на хосте (unit pragmatika-telemetry-probe,
# backup, healthwatch). Пусто в скриптах = метрики выключены; для alloy нужен существующий.
#TEXTFILE_METRICS_DIR=/var/lib/pragmatika/metrics
# Каталог метрик индексатора внутри его контейнера (том indexer-state, читает alloy).
# Не задана = /state; задана пустой = метрики индексатора выключены.
#INDEXER_METRICS_DIR=/state

# --- зрение: чтение фото и сканов моделью (этап 110) ---
# Картинки уходят в модель через маршрут шлюза /vision/v1/messages БЕЗ маскирования ПДн на
# картинке (решение владельца 27.10; позже - локальный OCR с закраской). Маршрут на шлюзе
# включается отдельно: VISION_ROUTE_ENABLED=1 (gateway/.env). false = «зрение выключено».
VISION_ENABLED=true
# Картинок за один ход агента (предел маршрута шлюза - 10)
VISION_MAX_IMAGES_PER_TURN=10
# Картинок из одного документа
VISION_MAX_IMAGES_PER_DOCUMENT=5
# Таймаут чтения одной картинки, мс (пусто = 90000)
VISION_TIMEOUT_MS=
# Подмена алиаса модели; пусто = ORDER_CALC_MODEL (алиас агентов, отдельный не заводится).
# Шлюз пускает на маршрут зрения только agent-main (VISION_ALLOWED_MODELS в gateway/.env);
# если ORDER_CALC_MODEL другой, добавьте его в VISION_ALLOWED_MODELS, иначе 403.
VISION_MODEL_ALIAS=
# Проверка «есть ли на картинке текст» перед отправкой в модель (сервис documents,
# POST /images/detect-text). Режимы:
#   off      - проверка не вызывается, всё как раньше;
#   log_only - проверка и счётчик image_text_gate_total (would_block_* = сколько заблокировал
#              бы enforce), картинки уходят в модель как раньше. Значение по умолчанию;
#   enforce  - картинка с текстом (возможны ПДн) или не прошедшая проверку (сбой, таймаут,
#              «не распознано») в модель НЕ уходит, сотрудник получает пометку.
# enforce меняет решение 27.10 («картинки напрямую, без маскирования», уточнено 28.10): включать
# только по решению владельца, предварительно посмотрев would_block_* в log_only.
# Решение владельца (п. 18): enforce (значение сверить на сервере); при IMAGE_TEXT_MODE=tokens
# режим главнее. Откат: вернуть IMAGE_TEXT_GATE=log_only (или off) и перезапустить core:
#   docker compose up -d core
IMAGE_TEXT_GATE=enforce
# Таймаут одной проверки, мс (пусто = 360000, включает очередь OCR 300 с); по истечении картинка
# считается непроверенной
IMAGE_TEXT_GATE_TIMEOUT_MS=
# Режим фото с текстом (приоритетнее IMAGE_TEXT_GATE; пусто = работает IMAGE_TEXT_GATE):
#   block    - как IMAGE_TEXT_GATE=enforce: фото с текстом в модель не уходит;
#   log_only - как IMAGE_TEXT_GATE=log_only: считаем would_block_*, фото уходят как раньше;
#   tokens   - (по умолчанию, этап 231) фото с текстом в модель зрения НЕ уходит: сервис mask
#              (либо Tesseract в documents при IMAGE_TEXT_OCR_IN_DOCUMENTS=true) распознаёт текст
#              и коды
#              (QR/штрихкоды), текст идёт агенту через обычную псевдонимизацию («Текст с фото:»).
#              Требует MASK_URL и MASK_TOKEN, иначе core не стартует. Плохо читаемое фото или
#              сбой mask - фото не отправляется (fail closed), сотрудник получает пометку.
# Сервис mask: профиль compose mask (COMPOSE_PROFILES=mask), в боевой набор не входит.
# Откат на блокировку: IMAGE_TEXT_MODE=block и docker compose up -d core.
IMAGE_TEXT_MODE=tokens
# Адрес сервиса mask (пример: http://mask:8320) и его Bearer-токен (gen-secrets.sh)
MASK_URL=
MASK_TOKEN=
# Таймаут запроса к mask, мс (пусто = 30000)
MASK_TIMEOUT_MS=
# Этап 224, по умолчанию включено в этапе 231. Источник текста для tokens: false - сервис mask
# (MASK_URL, MASK_TOKEN), как раньше; true (по умолчанию) - Tesseract в сервисе documents (POST
# /images/recognize-text): отдельный
# контейнер mask (+1536 МиБ к сумме mem_limit) не нужен, MASK_URL и MASK_TOKEN игнорируются.
# Сам режим по-прежнему включает IMAGE_TEXT_MODE=tokens; без него флаг ничего не меняет.
# Цена выбора: documents не читают QR и штрихкоды и не ищут нераспознанное письмо (рукопись).
# Выключить: IMAGE_TEXT_OCR_IN_DOCUMENTS=false и docker compose up -d core.
IMAGE_TEXT_OCR_IN_DOCUMENTS=true
# Порог качества текста с фото, 0..100 (40 по решению владельца 09.11; был 60). Mask не
# отдаёт среднюю уверенность, поэтому порог применяется к доле слов с низкой уверенностью:
# фото не отправляется, если таких слов больше (100 - порог) процентов.
DOCUMENTS_OCR_TEXT_MIN_CONF=40
# Картинки (jpg/jpeg/png/webp/gif/bmp/tiff) в папках источника: индексатор описывает фото
# (режим product) моделью через тот же маршрут шлюза и пишет описание с путём в базу знаний.
# ВЫКЛЮЧЕНО по умолчанию: расход токенов на всю шару. Перед включением оценить стоимость:
# python3 scripts/estimate-disk-images-cost.py <каталог>. Уважает и VISION_ENABLED.
VISION_DISK_IMAGES_ENABLED=false
# Отдельный ключ шлюза для индексатора (не LITELLM_API_KEY); пусто = картинки на диске
# выключены с предупреждением в логе.
VISION_INDEXER_API_KEY=
# Файл больше этого размера (байт) не описывается (15 МиБ)
VISION_DISK_IMAGES_MAX_BYTES=15728640
# Картинок в модель за один проход индексатора; остальные - следующими проходами
VISION_DISK_IMAGES_MAX_PER_RUN=50

# --- веб-поиск агентов (этап 67) ---
# gateway-провайдер (значение см. docs платформы, WEB_SEARCH_PROVIDER) - отдельный запрос поиска
# через шлюз (маршрут /search/v1/messages); yandex - Yandex
# Search API напрямую с сервера в РФ (шлюз и зарубежный выход не нужны) + собственное чтение
# страниц; disabled (по умолчанию) - «не настроено». При провайдере через шлюз и yandex запрос
# поиска НЕ
# анонимизируется: реальные ИНН, названия и ФИО уходят во внешний поиск в тексте запроса.
# Переключение для РФ-сервера: WEB_SEARCH_PROVIDER=yandex + YANDEX_SEARCH_API_KEY +
# YANDEX_SEARCH_FOLDER_ID (ниже), затем пересоздать app. Откат: провайдер через шлюз или disabled.
WEB_SEARCH_PROVIDER=disabled
# Предел обращений к поиску в одном запросе
WEB_SEARCH_MAX_USES=3
# Алиас модели вспомогательного запроса; пусто = DOCUMENTS_MODEL
WEB_SEARCH_MODEL_ALIAS=
# Таймаут одного запроса поиска, мс (пусто = 60000)
WEB_SEARCH_TIMEOUT_MS=
# Отдельный ключ маршрута поиска; пусто = LITELLM_API_KEY
WEB_SEARCH_API_KEY=
# Домены через запятую; allowed и blocked вместе задавать нельзя
WEB_SEARCH_ALLOWED_DOMAINS=
WEB_SEARCH_BLOCKED_DOMAINS=
# Местоположение для локальной выдачи (пусто = значения платформы по умолчанию)
WEB_SEARCH_COUNTRY=
WEB_SEARCH_CITY=
WEB_SEARCH_TIMEZONE=
# --- Голосовые сообщения (этапы 223 и 235) ---
# off (по умолчанию) - голосовой файл обрабатывается как раньше, распознавания нет.
# local (основной вариант) - faster-whisper в контейнере speech на этом же сервере: аудио не
# покидает внутреннюю сеть compose, принимает ogg/opus, mp3, m4a/aac, webm, wav. Требует
# профиль speech: COMPOSE_PROFILES=speech (или speech,telemetry), пересборку образа speech и
# пересоздание app. Профиль НЕОБЯЗАТЕЛЕН и на проде не включён (этап 245: голосовые Bitrix24
# расшифровывает портал, в агента приходит текст). В обязательную сумму памяти не входит: с ним
# база + telemetry + песочница + speech = 15880 МиБ (нужно >= 16904 видимых), в ВМ 16 ГБ не
# помещается, check-host.sh предупредит; включать только с добавлением ОЗУ.
# Без запущенного сервиса при local сотрудник получает «повторите позже», ядро не падает.
# Порядок, выбор модели и откат - docs/RUNBOOK.md, «Голосовые сообщения».
# yandex - Yandex SpeechKit (облако РФ), оставлен выключенным вариантом: аудио уходит стороннему
# сервису (152-ФЗ), принимается только Ogg Opus до 30 секунд.
# Расшифровка в обоих случаях идёт агенту обычным текстом сотрудника и маскируется как любое
# сообщение. Включение - решение владельца. Откат: SPEECH_TO_TEXT_PROVIDER=off и пересоздать app.
SPEECH_TO_TEXT_PROVIDER=off
# Модель local и откуда её взять при сборке образа speech (имя, репозиторий и ревизия меняются
# тройкой): small - Systran/faster-whisper-small; medium - Systran/faster-whisper-medium;
# large-v3-turbo - mobiuslabsgmbh/faster-whisper-large-v3-turbo. Выбор - по замеру,
# services/speech/README.md. Ревизия - полный sha коммита репозитория модели; sha256 каждого
# файла весов проверяется по services/speech/model-src/<имя>.sha256 (для новой модели манифест
# снимается заранее, README сервиса), несовпадение роняет сборку. Смена модели = пересборка
# образа и пересоздание speech.
SPEECH_MODEL_NAME=small
SPEECH_MODEL_REPO=Systran/faster-whisper-small
SPEECH_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
# Ширина луча (1 - жадное декодирование, самое быстрое)
SPEECH_BEAM_SIZE=1
# Сколько записей распознаются одновременно (веса модели общие, один экземпляр; +150 МиБ на
# запись) и потоков CPU на одну запись: контейнеру отдано cpus: 3, поэтому 3 x 1. Запросы
# сверх числа ждут место без отказа, в пределах SPEECH_JOB_TIMEOUT_SECONDS. Меняя, пересчитать
# mem_limit speech (services/speech/README.md, «Память»)
SPEECH_MAX_CONCURRENT_JOBS=3
SPEECH_CPU_THREADS=1
# Общий срок задания в сервисе, секунды: ожидание места + декодирование + распознавание. По
# истечении (и при обрыве соединения ядром) место освобождается, ffmpeg убивается. Меньше
# SPEECH_LOCAL_TIMEOUT_MS (1260 с). Расчёт: запись 300 с x худший RTF 0,9 + 10 с = 280 с;
# десять таких записей разом при 3 местах - четыре волны, десятая готова через 4 x 280 = 1120 с
# (ожидание лучше отказа, этап 239g); 1200 с держат пачку с запасом ~7%. Меняя число мест или
# предел длительности, пересчитать: ceil(записей / мест) x (длительность x 0,9 + 10)
SPEECH_JOB_TIMEOUT_SECONDS=1200
# Через сколько секунд простоя модель выгружается из памяти (при следующем голосовом грузится
# заново, первая расшифровка дольше на время загрузки)
SPEECH_IDLE_TTL_SECONDS=300
# Длина окна распознавания, секунды: запись читается с диска окнами, память от длины не зависит
SPEECH_WINDOW_SECONDS=120
# Предел времени декодирования одного файла ffmpeg, секунды
SPEECH_DECODE_TIMEOUT_SECONDS=120
# Общий срок запроса ядра к сервису speech, мс (пусто = 1260000); при занятом сервисе ядро
# повторяет запрос, пока срока хватает. SPEECH_TO_TEXT_MAX_SECONDS обязан укладываться:
# (срок в секундах - 10) / 0,9, при умолчании 1388 с; больше - ошибка старта. Должен быть
# больше SPEECH_JOB_TIMEOUT_SECONDS минимум на 60 с. Расшифровка идёт до хода агента:
# срок хода (CHAT_TURN_TIMEOUT_MS) отсчитывается после неё
SPEECH_LOCAL_TIMEOUT_MS=1260000
# Ключ сервисного аккаунта с ролью ai.speechkit-stt.user (СЕКРЕТ, в журналы не попадает).
# Только для yandex. Нет ключа - сервис стартует, голосовые идут прежним путём, в журнале
# предупреждение speech_to_text_unconfigured.
SPEECHKIT_API_KEY=
# Каталог; для ключа сервисного аккаунта необязателен
SPEECHKIT_FOLDER_ID=
# Таймаут одного запроса SpeechKit, мс (пусто = 20000); запрос платный, повторов нет
SPEECHKIT_TIMEOUT_MS=
# Пределы записи: секунд и байт. Пусто = умолчание провайдера: local - 300 секунд и 30 МиБ
# (31457280), выше нельзя 100 МиБ и предел по сроку выше; yandex - 30 секунд и 1000000 байт (выше
# предела синхронного API нельзя). Длиннее/больше - сотрудник получает просьбу записать короче.
# Те же переменные читает контейнер speech: держать согласованными.
SPEECH_TO_TEXT_MAX_SECONDS=
SPEECH_TO_TEXT_MAX_BYTES=
# true - перед ответом агента показывать сотруднику «Распознал: «…»»; по умолчанию false
SPEECH_TO_TEXT_ECHO=false
# --- Яндекс Поиск (этап 119; действуют только при WEB_SEARCH_PROVIDER=yandex) ---
# API-ключ сервисного аккаунта (секрет, в журналы не попадает) и идентификатор каталога.
# Нет любого из двух - сервис стартует, поиск «не настроен», в журнале предупреждение
# yandex_search_unconfigured с именами недостающих переменных.
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
# Таймаут одного запроса, мс (пусто = 15000)
YANDEX_SEARCH_TIMEOUT_MS=
# Регион выдачи - ЧИСЛОВОЙ идентификатор Яндекса, не код страны (пусто = 225, Россия;
# 213 - Москва, 2 - Санкт-Петербург)
YANDEX_SEARCH_REGION=
# Суточный предел запросов к Яндексу на весь сервис (сутки по МСК; пусто = 1000). Запрос платный
# (~0,49 руб. днём); при исчерпании поиск отвечает «лимит», оператору уходит одно оповещение
# в сутки. Считаются и неуспешные запросы (5xx, 401): так безопаснее для бюджета.
YANDEX_SEARCH_DAILY_MAX=
# Собственное чтение страниц сайтов (вместо web_fetch шлюза): таймаут, мс (пусто = 10000) и
# предел размера тела, байт (пусто = 2097152). Только http/https на порты 80/443, адреса
# приватных сетей и метаданных запрещены, редиректов не больше 3.
WEB_PAGE_FETCH_TIMEOUT_MS=
WEB_PAGE_FETCH_MAX_BYTES=
# Чтение сайта кандидата: при провайдере через шлюз - серверный web_fetch (тот же маршрут шлюза и
# модель,
# что у поиска), при yandex - собственный читатель страниц (работает, только если заданы ключ
# и каталог Яндекса). Пусто = true при провайдере через шлюз и yandex, иначе false; false выключает;
# true при WEB_SEARCH_PROVIDER=disabled - ошибка старта.
# Страницы оплачиваются как входные токены модели (отдельной платы за инструмент нет).
WEB_FETCH_ENABLED=
# Чтений в одном запросе (главная + контакты = 2); не больше 5 (предел шлюза)
WEB_FETCH_MAX_USES=2
# Предел содержимого одной страницы, токенов; не больше 50000 (предел шлюза)
WEB_FETCH_MAX_CONTENT_TOKENS=8000
# Чтений сайтов за один ход агента (по числу кандидатов в показе)
WEB_FETCH_MAX_PER_TURN=10

# ---------- 13. Платформа v2: флаги и пределы, новые относительно прежнего стека ----------
# Значения по умолчанию заданы в compose.project.yml (там, где у Прагматики было иначе, чем в
# базе платформы) либо в базе; строки ниже закомментированы и показывают умолчание.
# Постоянные идентификаторы: НЕ менять у работающей установки (разойдутся метки писем и
# команда кнопок, записанная в портале). Значения совпадают с прежними константами.
#MAIL_TAG_SALT_PREFIX=pragmatika
#BUTTON_COMMAND=labops_btn
# Включено у Прагматики всегда (в базе платформы выключено): инструмент поиска в интернете
# (провайдер выбирает WEB_SEARCH_PROVIDER), привязка задач к сделкам, ссылки портала, xlsx-шаблоны.
#WEB_SEARCH_ENABLED=true
#B24_TASK_DEAL_LINK=true
#B24_PORTAL_LINKS=true
#TEMPLATE_WORKBOOK_ENABLED=true
# Режимы сервиса documents, которые в прежнем коде были включены всегда.
#DOCUMENTS_EDIT_ENDPOINTS=true
#DOCUMENTS_TEMPLATE_ENDPOINTS=true
#DOCUMENTS_UNAMBIGUOUS_FRACTIONS=true
# Метка «Категория» собранных документов: по ней узнаются собственные файлы после
# пересохранения. Прежняя константа; менять нельзя.
#DOCUMENTS_RENDER_CATEGORY=pragmatika-own-document
# Пределы сервиса documents, которых не было в прежнем compose (умолчания платформы).
#DOCUMENTS_MAX_PDF_TOTAL_SECONDS=600
#DOCUMENTS_MAX_PDF_TEXT_CHARS=4000000
#DOCUMENTS_CONVERT_CONCURRENCY=
#DOCUMENTS_IMAGE_TEXT_ENDPOINT=true
#DOCUMENTS_OFFICE_CONVERT_ENDPOINTS=
# Новые функции платформы, выключены (поведение не меняют).
#PAIR_NOTES_ENABLED=false
#AGENT_SCRIPT_ERROR_FALLBACK=false
#WEB_SEARCH_LIMIT_WARNINGS=false
#EMAIL_DRAFT_LIMIT_WARNINGS=false
#FEEDBACK_LIMIT_WARNINGS=false
#MAIL_ALLOWED_SENDERS=
#CRM_WEBHOOK_URL=
#THREAD_RETENTION_DAYS=
#FILES_SUBDIR=
# Подробность журнала ошибок Postgres: terse и panic скрывают значения ключей и тексты
# запросов (ПДн); умолчания compose.project.yml боевые.
#POSTGRES_LOG_ERROR_VERBOSITY=terse
#POSTGRES_LOG_MIN_ERROR_STATEMENT=panic
# Откат учёта миграций на прежние имена версий (аварийный флаг раннера, обычно 0).
#MIGRATE_LEGACY_NAMES=0

# ---------- 14. Снятые переменные ----------
# Эти имена есть в боевом .env, но ядро их не читает: в коде прежнего репозитория на них нет
# ссылок (кроме теста, что снятая PRICES_UNVERIFIED_SENDER_POLICY игнорируется), в compose они
# не передаются. Значения безвредны; можно удалить из .env. Записаны здесь для полноты перечня
# боевых имён.
#PRICES_UNVERIFIED_SENDER_POLICY=
#SITE_PUBLISH_ENABLED=
