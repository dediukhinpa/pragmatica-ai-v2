# Совместимость старых имён переменных с базой платформы (подключается через include.env_file в
# compose.yml; значения разбирает сам compose, секретов здесь нет).
# База требует OWNER_THREAD_ID; на бою тред ответственного задан под прежним именем
# MANAGER_THREAD_ID. Явно заданный OWNER_THREAD_ID сильнее, иначе берётся MANAGER_THREAD_ID.
OWNER_THREAD_ID=${OWNER_THREAD_ID:-${MANAGER_THREAD_ID:-}}
# Личные заметки связок в насосе чата включает флаг платформы; у проекта они шли вместе с
# карточками поставщиков, поэтому по умолчанию флаг повторяет SUPPLIER_CARDS_ENABLED.
PAIR_NOTES_ENABLED=${PAIR_NOTES_ENABLED:-${SUPPLIER_CARDS_ENABLED:-false}}
# Правило «предупреждения вместо отказов» (WARNINGS_PROMPT) прежний код добавлял в промпт каждого
# агента всегда; в платформе оно за флагом с выключенным по умолчанию. Включаем, чтобы промпты
# агентов остались прежними.
FEEDBACK_LIMIT_WARNINGS=${FEEDBACK_LIMIT_WARNINGS:-true}
