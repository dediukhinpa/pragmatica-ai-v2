# Локальный lock образов: создаётся сборкой, образец лежит рядом с compose.
/deploy/images.lock
# Выводы инструментов (отчёты синхронизации и эталона) не входят в репозиторий.
/tmp/
# Пока пакеты берутся из локального реестра разработки, в lock попадает его адрес: lock
# коммитится после перехода на постоянный реестр (шлюзы G2/G4).
bun.lock
